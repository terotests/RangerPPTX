; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; PptxSmartArtTest — a SmartArt diagram read from its drawing, drawn, and saved
; ==============================================================================
;
;   npm run pptx:smartart:deck:test
;
; Fixture 38 holds two diagrams. "Process" has the drawing part PowerPoint
; saves beside a diagram's data: three steps and two arrows, which this reader
; draws as a group. "NoDrawing" has only its data, as anything but PowerPoint
; writes it, and the layout engine (smartart/) draws it from that: process1,
; the layout its data names.
;
; What a save has to do with the drawn one: put the SmartArt back as SmartArt
; (its own graphicFrame, with the relationships it names), restate only where
; it is, and — once its text was edited here — write it as the shapes it now
; is rather than a SmartArt that would contradict them.
; ==============================================================================

Import "../src/PptxModel.rgr"
Import "../src/PptxParser.rgr"
Import "../src/PptxResolver.rgr"
Import "../src/PptxEdit.rgr"
Import "../src/PptxWriter.rgr"
Import "../src/PptxToEvg.rgr"
Import "../../ooxml/OpcPackage.rgr"
Import "pkg:evg/EVGDisplayList.rgr"

class SmartArtCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn near:void (name:string got:double want:double) {
        def d:double (got - want)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (d < 0.05))
    }
}

class PptxSmartArtTest {

    sfn countOf:int (hay:string needle:string) {
        def n:int 0
        def from:int 0
        def rest:string hay
        def at:int (indexOf rest needle)
        while (at >= 0) {
            n = (n + 1)
            from = (at + (strlen needle))
            rest = (substring rest from (strlen rest))
            at = (indexOf rest needle)
        }
        return n
    }

    sfn byName:PptxShape (shapes:[PptxShape] name:string) {
        def i:int 0
        while (i < (array_length shapes)) {
            def s:PptxShape (itemAt shapes i)
            if (s.name == name) {
                return s
            }
            i = (i + 1)
        }
        return (new PptxShape())
    }

    sfn open:PptxParser () {
        def parser (new PptxParser())
        parser.openParts("gallery/pptx/fixtures" "38-smartart-drawing.pptx")
        return parser
    }

    sfn testRead:void (c:SmartArtCheck) {
        print "-- read --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def raw:PptxPresentation (parser.parsePresentation())
        c.eqInt("one slide" (raw.slideCount()) 1)
        def slide:PptxSlide (itemAt raw.slides 0)
        c.eqInt("the heading and both diagrams are shapes" (array_length slide.shapes) 3)
        def d:PptxShape (PptxSmartArtTest.byName(slide.shapes "Process"))
        c.ok("the diagram is one" d.isDiagram)
        c.ok("drawn as a group" (d.kind == (PptxShapeKind.group())))
        c.near("at the frame's left (1524000 EMU)" d.x 120.0)
        c.near("at the frame's top" d.y (1600000.0 / 12700.0))
        c.near("the frame's width" d.width (6096000.0 / 12700.0))
        c.near("its child space is the frame: width" d.chW d.width)
        c.near("height" d.chH d.height)
        c.near("from 0,0" (d.chX + d.chY) 0.0)
        c.eqInt("five shapes from the drawing" (array_length d.children) 5)
        def first:PptxShape (itemAt d.children 0)
        def arrow:PptxShape (itemAt d.children 1)
        def last:PptxShape (itemAt d.children 4)
        c.eqStr("a step is a rounded rectangle" first.preset "roundRect")
        c.eqStr("between steps an arrow" arrow.preset "rightArrow")
        c.eqStr("the first step's text" (first.text.plainText()) "Plan")
        c.eqStr("the last step's text" (last.text.plainText()) "Ship")
        c.near("children are in the frame's space: the first at 0" first.x 0.0)
        c.near("the last at 4496000 EMU" last.x (4496000.0 / 12700.0))
        c.ok("an arrow has no text" ((arrow.text.plainText()) == ""))
        c.eqStr("the diagram's text, from its data" d.diagramText "Plan\nBuild\nShip\n")
        c.ok("its signature was taken" ((strlen d.diagramSig) > 0))
        c.eqStr("which is what it says now" d.diagramSig (d.diagramSignature()))
        c.ok("its frame's span is known" d.diagramFrame.known)
        c.eqStr("in the slide part" d.diagramFrame.part "ppt/slides/slide1.xml")
        ; the one with no drawing: laid out by the engine
        c.eqInt("nothing is left unread" (array_length slide.opaque) 0)
        def nd:PptxShape (PptxSmartArtTest.byName(slide.shapes "NoDrawing"))
        c.ok("the diagram with no drawing is drawn too" nd.isDiagram)
        c.near("in its own frame" nd.y (3600000.0 / 12700.0))
        c.eqInt("as process1: two steps and an arrow" (array_length nd.children) 3)
        def ndFirst:PptxShape (itemAt nd.children 0)
        def ndArrow:PptxShape (itemAt nd.children 1)
        c.eqStr("its first step" (ndFirst.text.plainText()) "Ask")
        c.eqStr("the arrow" ndArrow.preset "rightArrow")
        c.ok("its frame is known, so a save keeps it SmartArt" nd.diagramFrame.known)
        c.eqStr("with its signature" nd.diagramSig (nd.diagramSignature()))
    }

    sfn testDraw:void (c:SmartArtCheck) {
        print "-- drawn --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def slide:PptxSlide (itemAt pres.slides 0)
        def d:PptxShape (PptxSmartArtTest.byName(slide.shapes "Process"))
        c.ok("the resolver keeps it a diagram" d.isDiagram)
        c.eqStr("and keeps its signature" d.diagramSig (d.diagramSignature()))
        def conv (new PptxToEvg())
        def dl:EVGDisplayList (conv.slideToDisplayList(slide))
        def planX:double -1.0
        def shipX:double -1.0
        def headingY:double -1.0
        def planY:double -1.0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if (cmd.text == "Plan") {
                planX = cmd.x
                planY = cmd.y
            }
            if (cmd.text == "Ship") {
                shipX = cmd.x
            }
            if (cmd.text == "SmartArt") {
                headingY = cmd.y
            }
            i = (i + 1)
        }
        c.ok("the first step's text is drawn" (planX >= 0.0))
        c.ok("the last step's too" (shipX >= 0.0))
        c.ok("left to right" (shipX > planX))
        c.ok("under the heading" (planY > headingY))
        ; frame at 120 pt; a drawing read in slide space instead of the frame's
        ; would put the first step's text at the slide's left edge
        def leftPx:double (conv.ptToPx(120.0))
        c.ok("inside the frame, not at the slide's edge" (planX > leftPx))
    }

    sfn save:string (pres:PptxPresentation parser:PptxParser name:string) {
        def writer (new PptxWriter())
        writer.saveOver(pres parser.pkg "gallery/pptx/bin" name)
        def out (new OpcPackage())
        if ((out.openParts("gallery/pptx/bin" name)) == false) {
            return ""
        }
        return (out.readXml("ppt/slides/slide1.xml"))
    }

    sfn edited:PptxPresentation (parser:PptxParser) {
        return ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
    }

    sfn testSaveMoved:void (c:SmartArtCheck) {
        print "-- saved after it was moved --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        def shapes:[PptxShape] (ed.editableShapes())
        def target:PptxShape (PptxSmartArtTest.byName(shapes "Process"))
        c.ok("the editor sees the diagram" target.isDiagram)
        ed.select(target.editId)
        ed.moveSelection(10.0 20.0)
        ; undo and redo go through the editor's copy of the shape
        ed.undo()
        ed.redo()
        def slide:PptxSlide (itemAt pres.slides 0)
        c.ok("the move marked the slide" slide.dirty)
        def moved:PptxShape (PptxSmartArtTest.byName(slide.shapes "Process"))
        c.ok("still a diagram after undo and redo" moved.isDiagram)
        def after:string (PptxSmartArtTest.save(pres parser "smartart-moved.pptx"))
        c.ok("the deck was written" ((strlen after) > 0))
        c.eqInt("both diagrams are SmartArt frames" (PptxSmartArtTest.countOf(after "<dgm:relIds")) 2)
        c.ok("the drawn one still names its data" ((indexOf after "r:dm=\"rId10\"") >= 0))
        ; the one with no drawing was laid out here: it is written whole, with
        ; a drawing, in parts of its own, so other readers can draw it too
        c.ok("the other written whole, in new parts" ((indexOf after "r:dm=\"rIdDgm-data3\"") >= 0))
        c.ok("no shapes from the drawing were written" ((indexOf after "rightArrow") < 0))
        ; 120 pt + 10 pt = 130 pt = 1651000 EMU
        c.ok("at its new place" ((indexOf after "<a:off x=\"1651000\" y=\"1854000\"/>") >= 0))
        c.ok("its size restated" ((indexOf after "<a:ext cx=\"6096000\" cy=\"1500000\"/>") >= 0))
        c.eqInt("one xfrm in the frame, not two" (PptxSmartArtTest.countOf(after "<p:xfrm>")) 2)
        def out (new OpcPackage())
        out.openParts("gallery/pptx/bin" "smartart-moved.pptx")
        def rels:string (out.readXml("ppt/slides/_rels/slide1.xml.rels"))
        c.ok("the diagram's relationships came through, the drawing's too"
            (((indexOf rels "rId10") >= 0) && ((indexOf rels "rId14") >= 0)))
        c.ok("and the parts are in the package"
            ((out.hasPart("ppt/diagrams/data1.xml")) && (out.hasPart("ppt/diagrams/drawing1.xml"))))
        ; and it reads back as the same diagram, where it was put
        def again (new PptxParser())
        again.openParts("gallery/pptx/bin" "smartart-moved.pptx")
        def raw2:PptxPresentation (again.parsePresentation())
        def s2:PptxSlide (itemAt raw2.slides 0)
        def d2:PptxShape (PptxSmartArtTest.byName(s2.shapes "Process"))
        c.ok("read back, it is a diagram" d2.isDiagram)
        c.near("at its new place" d2.x 130.0)
        c.eqInt("with its five shapes" (array_length d2.children) 5)
        def nd2:PptxShape (PptxSmartArtTest.byName(s2.shapes "NoDrawing"))
        c.ok("the other is drawn again from its data" (nd2.isDiagram && ((array_length nd2.children) == 3)))
        ; ids are numbered again on a write: no two shapes share one
        c.eqInt("the frame got a fresh id, not its old 3 twice" (PptxSmartArtTest.countOf(after "id=\"3\"")) 1)
    }

    sfn testSaveEdited:void (c:SmartArtCheck) {
        print "-- saved after its text was edited --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def slide:PptxSlide (itemAt pres.slides 0)
        def d:PptxShape (PptxSmartArtTest.byName(slide.shapes "Process"))
        def build:PptxShape (itemAt d.children 2)
        def para:PptxParagraph (itemAt build.text.paragraphs 0)
        def run:PptxTextRun (itemAt para.runs 0)
        run.text = "Build it"
        slide.dirty = true
        c.ok("an edit inside changes the signature" (d.diagramSig != (d.diagramSignature())))
        def after:string (PptxSmartArtTest.save(pres parser "smartart-edited.pptx"))
        c.ok("the edit was written" ((indexOf after "Build it") >= 0))
        c.eqInt("only the diagram with no drawing is still SmartArt" (PptxSmartArtTest.countOf(after "<dgm:relIds")) 1)
        c.ok("the edited one is a group of shapes" ((indexOf after "<p:grpSp>") >= 0))
        c.ok("with its arrows" ((indexOf after "rightArrow") >= 0))
    }

    sfn testNewFile:void (c:SmartArtCheck) {
        print "-- written as a new file --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "smartart-new.pptx")
        def out (new OpcPackage())
        def ok:boolean (out.openParts("gallery/pptx/bin" "smartart-new.pptx"))
        c.ok("a new file is written" ok)
        def xml:string (out.readXml("ppt/slides/slide1.xml"))
        ; a new package has none of the diagram's own parts, so its frame
        ; would name nothing: both are written whole, from their data, the
        ; drawn one with PowerPoint's drawing as its drawing part
        c.eqInt("both SmartArt in a new file" (PptxSmartArtTest.countOf(xml "<dgm:relIds")) 2)
        c.ok("none as loose shapes" ((indexOf xml "Plan") < 0))
        c.ok("the drawn one's drawing, as PowerPoint drew it" ((indexOf (out.readXml("ppt/diagrams/drawing1.xml")) ">Plan<") >= 0))
    }

    sfn dataOf:string (texts:[string]) {
        def pts:string "<dgm:pt modelId=\"0\" type=\"doc\"><dgm:prSet loTypeId=\"urn:microsoft.com/office/officeart/2005/8/layout/cycle2\"/></dgm:pt>"
        def cs:string ""
        def i:int 0
        while (i < (array_length texts)) {
            pts = (pts + "<dgm:pt modelId=\"n" + (to_string i) + "\"><dgm:t><a:p><a:r><a:t>" + (itemAt texts i) + "</a:t></a:r></a:p></dgm:t></dgm:pt>")
            cs = (cs + "<dgm:cxn srcId=\"0\" destId=\"n" + (to_string i) + "\"/>")
            i = (i + 1)
        }
        return ("<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><dgm:ptLst>" + pts + "</dgm:ptLst><dgm:cxnLst>" + cs + "</dgm:cxnLst></dgm:dataModel>")
    }

    ; the relationship in `rels` with this Id: its Type and Target
    sfn relOf:string (rels:string id:string) {
        def at:int (indexOf rels ("Id=\"" + id + "\""))
        if (at < 0) {
            return ""
        }
        def start:int (lastIndexOf (substring rels 0 at) "<Relationship")
        def rest:string (substring rels start (strlen rels))
        def end:int (indexOf rest "/>")
        return (substring rest 0 (end + 2))
    }

    sfn testNative:void (c:SmartArtCheck) {
        print "-- a diagram laid out here, saved as SmartArt --"
        ; the drawn diagram (Process) is written first, as data1 …; this one,
        ; NoDrawing, as data2 …
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def writer (new PptxWriter())
        writer.save(pres "gallery/pptx/bin" "smartart-native.pptx")
        def out (new OpcPackage())
        out.openParts("gallery/pptx/bin" "smartart-native.pptx")
        def xml:string (out.readXml("ppt/slides/slide1.xml"))
        def rels:string (out.readXml("ppt/slides/_rels/slide1.xml.rels"))
        def ct:string (out.readXml("[Content_Types].xml"))
        c.ok("the frame names its data" ((indexOf xml "r:dm=\"rIdDgm-data2\"") >= 0))
        c.ok("its layout, style and colours" ((((indexOf xml "r:lo=\"rIdDgm-layout2\"") >= 0) && ((indexOf xml "r:qs=\"rIdDgm-quickStyle2\"") >= 0)) && ((indexOf xml "r:cs=\"rIdDgm-colors2\"") >= 0)))
        c.ok("the frame is where the diagram was" ((indexOf xml "<a:off x=\"1524000\" y=\"3600000\"/>") >= 0))
        def dm:string (PptxSmartArtTest.relOf(rels "rIdDgm-data2"))
        c.ok(("the data relationship (" + dm + ")") (((indexOf dm "relationships/diagramData\"") >= 0) && ((indexOf dm "Target=\"../diagrams/data2.xml\"") >= 0)))
        c.ok("the layout's" ((indexOf (PptxSmartArtTest.relOf(rels "rIdDgm-layout2")) "relationships/diagramLayout\"") >= 0))
        c.ok("the quick style's" ((indexOf (PptxSmartArtTest.relOf(rels "rIdDgm-quickStyle2")) "relationships/diagramQuickStyle\"") >= 0))
        c.ok("the colours'" ((indexOf (PptxSmartArtTest.relOf(rels "rIdDgm-colors2")) "relationships/diagramColors\"") >= 0))
        c.ok("the drawing's, Microsoft's kind" ((indexOf (PptxSmartArtTest.relOf(rels "rIdDgm-drawing2")) "http://schemas.microsoft.com/office/2007/relationships/diagramDrawing") >= 0))
        c.ok("content types: data" ((indexOf ct "PartName=\"/ppt/diagrams/data2.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.drawingml.diagramData+xml\"") >= 0))
        c.ok("layout" ((indexOf ct "PartName=\"/ppt/diagrams/layout2.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.drawingml.diagramLayout+xml\"") >= 0))
        c.ok("style" ((indexOf ct "PartName=\"/ppt/diagrams/quickStyle2.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.drawingml.diagramStyle+xml\"") >= 0))
        c.ok("colours" ((indexOf ct "PartName=\"/ppt/diagrams/colors2.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.drawingml.diagramColors+xml\"") >= 0))
        c.ok("drawing" ((indexOf ct "PartName=\"/ppt/diagrams/drawing2.xml\" ContentType=\"application/vnd.ms-office.drawingml.diagramDrawing+xml\"") >= 0))
        def data:string (out.readXml("ppt/diagrams/data2.xml"))
        c.ok("the data names its drawing by the slide's relationship" ((indexOf data "relId=\"rIdDgm-drawing2\"") >= 0))
        c.ok("every id a number" (((indexOf data "modelId=\"0\"") >= 0) && ((indexOf data "modelId=\"{") < 0)))
        c.ok("the document point names the layout it was drawn with" ((indexOf data "loTypeId=\"urn:microsoft.com/office/officeart/2005/8/layout/process1\"") >= 0))
        c.ok("and the style and colours" (((indexOf data "qsTypeId=\"urn:microsoft.com/office/officeart/2005/8/quickstyle/simple1\"") >= 0) && ((indexOf data "csTypeId=\"urn:microsoft.com/office/officeart/2005/8/colors/accent1_2\"") >= 0)))
        c.ok("with its text" (((indexOf data ">Ask<") >= 0) && ((indexOf data ">Answer<") >= 0)))
        def lo:string (out.readXml("ppt/diagrams/layout2.xml"))
        c.ok("the layout part is a layout definition" (((indexOf lo "<dgm:layoutDef") >= 0) && ((indexOf lo "layout/process1\"") >= 0)))
        def qs:string (out.readXml("ppt/diagrams/quickStyle2.xml"))
        c.ok("the quick style part" (((indexOf qs "<dgm:styleDef") >= 0) && ((indexOf qs "<dgm:styleLbl name=\"node1\">") >= 0)))
        def cs:string (out.readXml("ppt/diagrams/colors2.xml"))
        c.ok("the colour part" (((indexOf cs "<dgm:colorsDef") >= 0) && ((indexOf cs "colors/accent1_2\"") >= 0)))
        c.ok("a node is filled with the accent" ((indexOf cs "<dgm:styleLbl name=\"node1\"><dgm:fillClrLst meth=\"repeat\"><a:schemeClr val=\"accent1\"/>") >= 0))
        def dr:string (out.readXml("ppt/diagrams/drawing2.xml"))
        c.eqInt("the drawing: two steps and an arrow" (PptxSmartArtTest.countOf(dr "<dsp:sp ")) 3)
        c.ok("with their text" (((indexOf dr ">Ask<") >= 0) && ((indexOf dr "<dsp:txBody>") >= 0)))
        c.ok("in the drawing's own namespace" ((indexOf dr "<p:") < 0))
        c.ok("its text shrinks rather than breaking words in a wider font" ((indexOf dr "<a:normAutofit/></a:bodyPr>") >= 0))
        ; read back: the same diagram, from the drawing written here
        def again (new PptxParser())
        again.openParts("gallery/pptx/bin" "smartart-native.pptx")
        def raw:PptxPresentation (again.parsePresentation())
        def s0:PptxSlide (itemAt raw.slides 0)
        def nd:PptxShape (PptxSmartArtTest.byName(s0.shapes "NoDrawing"))
        c.ok("read back, a diagram" nd.isDiagram)
        c.eqInt("its three shapes" (array_length nd.children) 3)
        c.near("where it was" nd.x 120.0)
    }

    sfn testNativeOver:void (c:SmartArtCheck) {
        print "-- a new diagram saved over the file --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def slide:PptxSlide (itemAt pres.slides 0)
        def texts:[string] ([] _:string ("Spring" "Summer" "Autumn"))
        def r:SaResult (SaEngine.layout((PptxSmartArtTest.dataOf(texts)) (new SaOptions()) 300.0 200.0))
        c.ok("laid out" r.ok)
        def g:PptxShape r.shape
        g.name = "Seasons"
        g.x = 400.0
        g.y = 300.0
        c.ok("the engine says what it was made from" (((strlen g.diagramModelXml) > 0) && ((strlen g.diagramLayoutXml) > 0)))
        c.eqStr("its layout" g.diagramLayoutId "urn:microsoft.com/office/officeart/2005/8/layout/cycle2")
        c.eqStr("its colours" g.diagramColorsId "urn:microsoft.com/office/officeart/2005/8/colors/accent1_2")
        c.eqStr("its style" g.diagramStyleId "urn:microsoft.com/office/officeart/2005/8/quickstyle/simple1")
        c.ok("its shapes as made" (g.diagramSig == (g.diagramSignature())))
        push slide.shapes g
        slide.dirty = true
        def after:string (PptxSmartArtTest.save(pres parser "smartart-native-over.pptx"))
        c.eqInt("three SmartArt frames" (PptxSmartArtTest.countOf(after "<dgm:relIds")) 3)
        ; the file already has data1, data2 and layout1 …: the parts written
        ; here take names it does not use — the drawingless diagram's first
        ; (data3, layout2), then the new one's (data4, layout3)
        c.ok("the new data parts' names are free ones" (((indexOf after "r:dm=\"rIdDgm-data3\"") >= 0) && ((indexOf after "r:dm=\"rIdDgm-data4\"") >= 0)))
        c.ok("as are their layouts'" ((indexOf after "r:lo=\"rIdDgm-layout3\"") >= 0))
        def out (new OpcPackage())
        out.openParts("gallery/pptx/bin" "smartart-native-over.pptx")
        def rels:string (out.readXml("ppt/slides/_rels/slide1.xml.rels"))
        c.eqInt("every relationship id once" (PptxSmartArtTest.countOf(rels "Id=\"rIdDgm-data3\"")) 1)
        c.ok("the old diagrams' relationships kept" (((indexOf rels "Id=\"rId10\"") >= 0) && ((indexOf rels "Id=\"rId15\"") >= 0)))
        c.ok("the old parts kept" ((out.hasPart("ppt/diagrams/data1.xml")) && (out.hasPart("ppt/diagrams/data2.xml"))))
        c.ok("the new ones there" ((out.hasPart("ppt/diagrams/data4.xml")) && (out.hasPart("ppt/diagrams/drawing3.xml"))))
        def ct:string (out.readXml("[Content_Types].xml"))
        c.ok("and typed" ((indexOf ct "/ppt/diagrams/drawing3.xml\" ContentType=\"application/vnd.ms-office.drawingml.diagramDrawing+xml\"") >= 0))
        def again (new PptxParser())
        again.openParts("gallery/pptx/bin" "smartart-native-over.pptx")
        def raw:PptxPresentation (again.parsePresentation())
        def s0:PptxSlide (itemAt raw.slides 0)
        def back:PptxShape (PptxSmartArtTest.byName(s0.shapes "Seasons"))
        c.ok("read back, a diagram" back.isDiagram)
        c.eqInt("three seasons and three arrows" (array_length back.children) 6)
        ; saved again over itself: the frame kept, nothing doubled
        def pres2:PptxPresentation ((new PptxResolver()).resolvePresentation(raw))
        def sl2:PptxSlide (itemAt pres2.slides 0)
        sl2.dirty = true
        def w2 (new PptxWriter())
        w2.saveOver(pres2 again.pkg "gallery/pptx/bin" "smartart-native-twice.pptx")
        def out2 (new OpcPackage())
        out2.openParts("gallery/pptx/bin" "smartart-native-twice.pptx")
        def rels2:string (out2.readXml("ppt/slides/_rels/slide1.xml.rels"))
        c.eqInt("saved twice: still one relationship to its data" (PptxSmartArtTest.countOf(rels2 "../diagrams/data4.xml")) 1)
        c.eqInt("still three frames" (PptxSmartArtTest.countOf((out2.readXml("ppt/slides/slide1.xml")) "<dgm:relIds")) 3)
    }

    sfn sizeOf:double (sh:PptxShape) {
        if ((array_length sh.text.paragraphs) == 0) {
            return 0.0
        }
        def para:PptxParagraph (itemAt sh.text.paragraphs 0)
        if ((array_length para.runs) == 0) {
            return 0.0
        }
        def run:PptxTextRun (itemAt para.runs 0)
        return run.fontSizePt
    }

    ; the diagram's shapes that have text, in order
    sfn texted:[PptxShape] (d:PptxShape) {
        def out:[PptxShape]
        def i:int 0
        while (i < (array_length d.children)) {
            def c:PptxShape (itemAt d.children i)
            if ((strlen (c.text.plainText())) > 0) {
                push out c
            }
            i = (i + 1)
        }
        return out
    }

    sfn testRelayout:void (c:SmartArtCheck) {
        print "-- its text edited in the editor: laid out again --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def slide:PptxSlide (itemAt pres.slides 0)
        def texts:[string] ([] _:string ("Spring" "Summer" "Autumn"))
        def r:SaResult (SaEngine.layout((PptxSmartArtTest.dataOf(texts)) (new SaOptions()) 300.0 200.0))
        def g:PptxShape r.shape
        g.name = "Seasons"
        g.x = 400.0
        g.y = 300.0
        def rs (new PptxResolver())
        rs.resolveShape(g pres.theme)
        push slide.shapes g
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        def d:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        def before:[PptxShape] (PptxSmartArtTest.texted(d))
        c.eqInt("three steps with text" (array_length before) 3)
        def first:PptxShape (itemAt before 0)
        def oldSize:double (PptxSmartArtTest.sizeOf(first))
        c.eqStr("each knows its point" (itemAt first.diagramParaPts 0) "n0")
        def oldId:int first.editId
        c.ok("a shape in the diagram can be typed into" (ed.beginTextEdit(oldId)))
        ed.selectAllText()
        ed.typeAtCaret("Spring is the season of new beginnings")
        ed.endTextEdit()
        def d2:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        def after:[PptxShape] (PptxSmartArtTest.texted(d2))
        def f2:PptxShape (itemAt after 0)
        c.eqStr("the edit is in the diagram" (f2.text.plainText()) "Spring is the season of new beginnings")
        c.ok("laid out again: new shapes" (f2.editId != oldId))
        c.ok(("the longer text set smaller (" + (to_string (PptxSmartArtTest.sizeOf(f2))) + " < " + (to_string oldSize) + ")") ((PptxSmartArtTest.sizeOf(f2)) < oldSize))
        def s2:PptxShape (itemAt after 1)
        c.near("and the others with it: one size" (PptxSmartArtTest.sizeOf(s2)) (PptxSmartArtTest.sizeOf(f2)))
        c.ok("the data says so" ((indexOf d2.diagramModelXml "Spring is the season of new beginnings") >= 0))
        c.ok("its shapes are what it was laid out as" (d2.diagramSig == (d2.diagramSignature())))
        c.ok(("in the slide's colours: resolved (" + f2.fill.srgb + ")") ((strlen f2.fill.srgb) == 6))
        c.ok("still where it was" ((d2.x == 400.0) && (d2.width == 300.0)))
        ; saved: SmartArt with the new text
        def after2:string (PptxSmartArtTest.save(pres parser "smartart-relaid.pptx"))
        def out (new OpcPackage())
        out.openParts("gallery/pptx/bin" "smartart-relaid.pptx")
        def datas:[string] (out.listParts())
        def found:boolean false
        def i:int 0
        while (i < (array_length datas)) {
            def part:string (itemAt datas i)
            if ((indexOf part "ppt/diagrams/data") == 0) {
                if ((indexOf (out.readXml(part)) "season of new beginnings") >= 0) {
                    found = true
                }
            }
            i = (i + 1)
        }
        c.ok("saved as SmartArt, its data the edited text" found)
        c.eqInt("three frames" (PptxSmartArtTest.countOf(after2 "<dgm:relIds")) 3)
        ; undone: the text and the layout before it
        ed.undo()
        def d3:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        def f3:PptxShape (itemAt (PptxSmartArtTest.texted(d3)) 0)
        c.ok(("undo takes the layout back with the text (" + (f3.text.plainText()) + ")") ((f3.text.plainText()) != "Spring is the season of new beginnings"))
        ; setShapeText lays it out again too
        def d4:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        def f4:PptxShape (itemAt (PptxSmartArtTest.texted(d4)) 1)
        ed.setShapeText(f4.editId "High summer")
        def d5:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        c.ok("setShapeText: in the data" ((indexOf d5.diagramModelXml "High summer") >= 0))
        c.ok("and drawn" ((PptxSmartArtTest.texts(d5)) == "Spring|High summer|Autumn"))
        ; a shape that is not in a diagram: nothing to lay out
        c.ok("a shape in no diagram: no" ((ed.relayoutDiagramOf(d5.editId)) == false))
    }

    sfn texts:string (d:PptxShape) {
        def out:string ""
        def l:[PptxShape] (PptxSmartArtTest.texted(d))
        def i:int 0
        while (i < (array_length l)) {
            if (i > 0) {
                out = (out + "|")
            }
            def sh:PptxShape (itemAt l i)
            out = (out + (sh.text.plainText()))
            i = (i + 1)
        }
        return out
    }

    sfn testRelayoutReopened:void (c:SmartArtCheck) {
        print "-- a diagram reopened from the file we wrote, edited --"
        def parser (new PptxParser())
        parser.openParts("gallery/pptx/bin" "smartart-native-over.pptx")
        def pres:PptxPresentation ((new PptxResolver()).resolvePresentation((parser.parsePresentation())))
        def slide:PptxSlide (itemAt pres.slides 0)
        def d:PptxShape (PptxSmartArtTest.byName(slide.shapes "Seasons"))
        c.ok("read from its drawing" d.diagramHadDrawing)
        c.ok("with what it was made from" (SaEdit.canRelayout(d)))
        def f:PptxShape (itemAt (PptxSmartArtTest.texted(d)) 0)
        c.ok("each shape knows its point" ((array_length f.diagramParaPts) == 1))
        def ed (new PptxEditor())
        ed.attach(pres)
        ed.gotoSlide(0)
        def de:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        def fe:PptxShape (itemAt (PptxSmartArtTest.texted(de)) 0)
        ed.setShapeText(fe.editId "Early spring")
        def d2:PptxShape (PptxSmartArtTest.byName(ed.editableShapes() "Seasons"))
        c.eqStr("laid out again with the edit" (PptxSmartArtTest.texts(d2)) "Early spring|Summer|Autumn")
        c.ok("no longer PowerPoint's drawing of it" (d2.diagramHadDrawing == false))
        def w (new PptxWriter())
        w.saveOver(pres parser.pkg "gallery/pptx/bin" "smartart-reopened.pptx")
        def again (new PptxParser())
        again.openParts("gallery/pptx/bin" "smartart-reopened.pptx")
        def raw:PptxPresentation (again.parsePresentation())
        def s0:PptxSlide (itemAt raw.slides 0)
        def back:PptxShape (PptxSmartArtTest.byName(s0.shapes "Seasons"))
        c.eqStr("saved and read back with the edit" (PptxSmartArtTest.texts(back)) "Early spring|Summer|Autumn")
        c.ok("as SmartArt" back.isDiagram)
        ; the untouched PowerPoint diagram keeps its own frame
        def xml:string (again.pkg.readXml("ppt/slides/slide1.xml"))
        c.ok("the untouched one keeps its frame" ((indexOf xml "r:dm=\"rId10\"") >= 0))
        ; a drawing whose shapes name no point of the data cannot be laid out
        ; again from an edit: its shapes are kept as edited
        def p2:PptxParser (PptxSmartArtTest.open())
        def pres2:PptxPresentation (PptxSmartArtTest.edited(p2))
        def ed2 (new PptxEditor())
        ed2.attach(pres2)
        ed2.gotoSlide(0)
        def proc:PptxShape (PptxSmartArtTest.byName(ed2.editableShapes() "Process"))
        def pc:PptxShape (itemAt proc.children 2)
        c.ok("a drawing that names no point: not laid out again" ((ed2.relayoutDiagramOf(pc.editId)) == false))
    }

    sfn testNativeEdited:void (c:SmartArtCheck) {
        print "-- a diagram laid out here, its shapes moved by hand --"
        def parser:PptxParser (PptxSmartArtTest.open())
        def pres:PptxPresentation (PptxSmartArtTest.edited(parser))
        def slide:PptxSlide (itemAt pres.slides 0)
        def texts:[string] ([] _:string ("One" "Two"))
        def r:SaResult (SaEngine.layout((PptxSmartArtTest.dataOf(texts)) (new SaOptions()) 300.0 200.0))
        def g:PptxShape r.shape
        g.name = "Moved"
        def first:PptxShape (itemAt g.children 0)
        first.x = (first.x + 15.0)
        push slide.shapes g
        slide.dirty = true
        def after:string (PptxSmartArtTest.save(pres parser "smartart-native-moved.pptx"))
        c.eqInt("not SmartArt any more: the two old frames only" (PptxSmartArtTest.countOf(after "<dgm:relIds")) 2)
        c.ok("its shapes, as they were left" (((indexOf after "name=\"Moved\"") >= 0) && ((indexOf after ">One<") >= 0)))
        ; nothing to write it from: shapes
        def bare (new PptxShape())
        bare.kind = (PptxShapeKind.group())
        bare.isDiagram = true
        bare.name = "Bare"
        def w (new PptxWriter())
        c.eqStr("no source, no SmartArt" (w.smartArtXml(bare)) "")
    }

    sfn main:void () {
        print "== PptxSmartArtTest =="
        def c (new SmartArtCheck())
        PptxSmartArtTest.testRead(c)
        PptxSmartArtTest.testDraw(c)
        PptxSmartArtTest.testSaveMoved(c)
        PptxSmartArtTest.testSaveEdited(c)
        PptxSmartArtTest.testNewFile(c)
        PptxSmartArtTest.testNative(c)
        PptxSmartArtTest.testNativeOver(c)
        PptxSmartArtTest.testNativeEdited(c)
        PptxSmartArtTest.testRelayout(c)
        PptxSmartArtTest.testRelayoutReopened(c)
        print ""
        print ("passed = " + (to_string c.passed) + "  failed = " + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}
