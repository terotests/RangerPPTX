; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaDataTest — the data model: what is read, what is refused, what is written
; ==============================================================================
;
;   npm run pptx:smartart:test      (JavaScript, C++ and Go)
;
; Every refusal is checked by the words it says, not just by failing: the
; message is what a model reads before it writes the file again.
; ==============================================================================

Import "../SaModel.rgr"
Import "../SaDataReader.rgr"
Import "../SaDataWriter.rgr"

class SaCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    ; the file is refused, and the reason says `words`
    fn refused:void (name:string xml:string words:string) {
        def r:SaReadResult (SaDataReader.read(xml))
        this.ok((name + " (said '" + r.error + "')") ((r.ok == false) && ((indexOf r.error words) >= 0)))
    }
}

class SaDataTest {

    sfn pt:SaPoint (m:SaModel id:string) {
        def p@(optional):SaPoint (m.pointById(id))
        if (null? p) {
            return (new SaPoint())
        }
        return (unwrap p)
    }

    sfn open:string () {
        return "<dgm:dataModel xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\">"
    }

    sfn doc:string () {
        return "<dgm:pt modelId=\"0\" type=\"doc\"><dgm:prSet loTypeId=\"urn:microsoft.com/office/officeart/2005/8/layout/process1\"/></dgm:pt>"
    }

    sfn node:string (id:string text:string) {
        return ("<dgm:pt modelId=\"" + id + "\"><dgm:t><a:p><a:r><a:t>" + text + "</a:t></a:r></a:p></dgm:t></dgm:pt>")
    }

    sfn cxn:string (id:string src:string dest:string ord:int) {
        return ("<dgm:cxn modelId=\"" + id + "\" srcId=\"" + src + "\" destId=\"" + dest + "\" srcOrd=\"" + (to_string ord) + "\"/>")
    }

    sfn file:string (pts:string cxns:string) {
        return ((SaDataTest.open()) + "<dgm:ptLst>" + pts + "</dgm:ptLst><dgm:cxnLst>" + cxns + "</dgm:cxnLst></dgm:dataModel>")
    }

    ; the smallest file the plan promises to read
    sfn minimal:string () {
        def pts:string ((SaDataTest.doc()) + (SaDataTest.node("1" "Plan")) + (SaDataTest.node("2" "Build")) + (SaDataTest.node("3" "Ship")))
        def cs:string ((SaDataTest.cxn("10" "0" "1" 0)) + (SaDataTest.cxn("11" "0" "2" 1)) + (SaDataTest.cxn("12" "0" "3" 2)))
        return (SaDataTest.file(pts cs))
    }

    sfn testMinimal:void (c:SaCheck) {
        print "-- the smallest file --"
        def r:SaReadResult (SaDataReader.read((SaDataTest.minimal())))
        c.ok("it is read" r.ok)
        c.eqStr("with no error" r.error "")
        def m:SaModel r.model
        c.eqInt("four points" (array_length m.points) 4)
        c.eqInt("three connections" (array_length m.cxns) 3)
        c.eqStr("the layout comes from the document point" (m.layoutId()) "urn:microsoft.com/office/officeart/2005/8/layout/process1")
        c.eqStr("the outline, in order" (m.outline()) "Plan\nBuild\nShip\n")
        def p1:SaPoint (SaDataTest.pt(m "1"))
        c.eqStr("a point with no type is a node" p1.type "node")
        def k0:SaCxn (itemAt m.cxns 0)
        c.eqStr("a connection with no type is parOf" k0.type "parOf")
        c.eqInt("depth of a child of the document" (m.depthOf("2")) 1)
        c.eqInt("depth of the document" (m.depthOf("0")) 0)
        c.eqStr("no drawing named" m.drawingRelId "")
    }

    sfn testOrder:void (c:SaCheck) {
        print "-- order --"
        def pts:string ((SaDataTest.doc()) + (SaDataTest.node("a" "A")) + (SaDataTest.node("b" "B")) + (SaDataTest.node("c" "C")))
        ; written out of order: srcOrd decides
        def cs:string ((SaDataTest.cxn("x" "0" "c" 2)) + (SaDataTest.cxn("y" "0" "a" 0)) + (SaDataTest.cxn("z" "0" "b" 1)))
        def r:SaReadResult (SaDataReader.read((SaDataTest.file(pts cs))))
        c.eqStr("srcOrd puts the children in order" (r.model.outline()) "A\nB\nC\n")
        ; no srcOrd at all: the order of the file
        def cs2:string "<dgm:cxn srcId=\"0\" destId=\"c\"/><dgm:cxn srcId=\"0\" destId=\"a\"/><dgm:cxn srcId=\"0\" destId=\"b\"/>"
        def r2:SaReadResult (SaDataReader.read((SaDataTest.file(pts cs2))))
        c.ok("connections without ids or srcOrd are read" r2.ok)
        c.eqStr("and keep the order they were written in" (r2.model.outline()) "C\nA\nB\n")
        ; equal srcOrd: file order breaks the tie
        def cs3:string ((SaDataTest.cxn("x" "0" "b" 0)) + (SaDataTest.cxn("y" "0" "a" 0)) + (SaDataTest.cxn("z" "0" "c" 0)))
        def r3:SaReadResult (SaDataReader.read((SaDataTest.file(pts cs3))))
        c.eqStr("equal srcOrd keeps file order" (r3.model.outline()) "B\nA\nC\n")
    }

    sfn testTree:void (c:SaCheck) {
        print "-- a tree --"
        def pts:string ((SaDataTest.doc()) + (SaDataTest.node("1" "CEO")) + (SaDataTest.node("2" "CTO")) + (SaDataTest.node("3" "CFO")) + (SaDataTest.node("4" "Dev")) + "<dgm:pt modelId=\"5\" type=\"asst\"><dgm:t><a:p><a:r><a:t>Assistant</a:t></a:r></a:p></dgm:t></dgm:pt>")
        def cs:string ((SaDataTest.cxn("c1" "0" "1" 0)) + (SaDataTest.cxn("c2" "1" "2" 0)) + (SaDataTest.cxn("c3" "1" "3" 1)) + (SaDataTest.cxn("c4" "2" "4" 0)) + (SaDataTest.cxn("c5" "1" "5" 2)))
        def r:SaReadResult (SaDataReader.read((SaDataTest.file(pts cs))))
        c.ok("a tree is read" r.ok)
        c.eqStr("its outline" (r.model.outline()) "CEO\n  CTO\n    Dev\n  CFO\n  Assistant\n")
        c.eqInt("depth 3" (r.model.depthOf("4")) 3)
        c.eqInt("three children under the CEO" (array_length (r.model.children("1"))) 3)
        def asst:SaPoint (SaDataTest.pt(r.model "5"))
        c.ok("an assistant is content" (asst.isContent()))
        c.eqInt("one assistant" (r.model.countOf("asst")) 1)
    }

    sfn testText:void (c:SaCheck) {
        print "-- text --"
        def t:string "<dgm:pt modelId=\"1\"><dgm:t><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang=\"fi-FI\" sz=\"1850\" b=\"1\" i=\"1\" u=\"sng\"><a:solidFill><a:srgbClr val=\"ff0000\"/></a:solidFill></a:rPr><a:t>Tom &amp; Jerry</a:t></a:r><a:br/><a:r><a:t>line two</a:t></a:r></a:p><a:p><a:pPr lvl=\"1\"/><a:r><a:t>sub </a:t></a:r><a:r><a:rPr b=\"0\"/><a:t>point</a:t></a:r></a:p></dgm:t></dgm:pt>"
        def empty:string "<dgm:pt modelId=\"2\"><dgm:t/></dgm:pt><dgm:pt modelId=\"3\"/>"
        def cs:string ((SaDataTest.cxn("c1" "0" "1" 0)) + (SaDataTest.cxn("c2" "0" "2" 1)) + (SaDataTest.cxn("c3" "0" "3" 2)))
        def r:SaReadResult (SaDataReader.read((SaDataTest.file(((SaDataTest.doc()) + t + empty) cs))))
        c.ok("formatted text is read" r.ok)
        def p:SaPoint (SaDataTest.pt(r.model "1"))
        c.eqInt("two paragraphs" (array_length p.paras) 2)
        def p0:SaPara (itemAt p.paras 0)
        def r0:SaRun (itemAt p0.runs 0)
        c.eqStr("an entity is decoded" r0.text "Tom & Jerry")
        c.ok("bold" r0.bold)
        c.ok("italic" r0.italic)
        c.ok("underlined" r0.underline)
        c.ok("18.5 pt" ((r0.sizePt > 18.49) && (r0.sizePt < 18.51)))
        c.eqStr("colour upper-cased" r0.color "FF0000")
        def br:SaRun (itemAt p0.runs 1)
        c.eqStr("a line break is a newline run" br.text "\n")
        c.eqInt("three runs in the first paragraph" (array_length p0.runs) 3)
        def p1:SaPara (itemAt p.paras 1)
        c.eqInt("the second paragraph is level 1" p1.level 1)
        c.eqStr("its text, the space kept" (p1.plainText()) "sub point")
        def notBold:SaRun (itemAt p1.runs 1)
        c.ok("b=\"0\" is not bold" (notBold.bold == false))
        c.eqStr("plain text joins paragraphs with a newline" (p.plainText()) "Tom & Jerry\nline two\nsub point")
        def e:SaPoint (SaDataTest.pt(r.model "2"))
        c.ok("an empty dgm:t is text that is there" e.hasText)
        c.eqInt("with no paragraphs" (array_length e.paras) 0)
        def n:SaPoint (SaDataTest.pt(r.model "3"))
        c.ok("no dgm:t is no text" (n.hasText == false))
    }

    ; What PowerPoint writes: GUID ids, transitions, presentation points,
    ; presOf / presParOf, and the link to the drawing.
    sfn powerPointFile:string () {
        def pts:string "<dgm:pt modelId=\"{D1}\" type=\"doc\"><dgm:prSet loTypeId=\"urn:microsoft.com/office/officeart/2005/8/layout/default\" loCatId=\"list\" qsTypeId=\"urn:microsoft.com/office/officeart/2005/8/quickstyle/simple1\" qsCatId=\"simple\" csTypeId=\"urn:microsoft.com/office/officeart/2005/8/colors/accent1_2\" csCatId=\"accent1\" phldr=\"1\"/><dgm:spPr/><dgm:t><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang=\"en-US\"/></a:p></dgm:t></dgm:pt>"
        pts = (pts + "<dgm:pt modelId=\"{N1}\"><dgm:prSet phldrT=\"[Text]\"/><dgm:spPr/><dgm:t><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang=\"en-US\"/><a:t>One</a:t></a:r></a:p></dgm:t></dgm:pt>")
        pts = (pts + "<dgm:pt modelId=\"{P1}\" type=\"parTrans\" cxnId=\"{C1}\"><dgm:prSet/><dgm:spPr/><dgm:t><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang=\"en-US\"/></a:p></dgm:t></dgm:pt>")
        pts = (pts + "<dgm:pt modelId=\"{S1}\" type=\"sibTrans\" cxnId=\"{C1}\"><dgm:prSet/><dgm:spPr/><dgm:t><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang=\"en-US\"/></a:p></dgm:t></dgm:pt>")
        pts = (pts + "<dgm:pt modelId=\"{R0}\" type=\"pres\"><dgm:prSet presAssocID=\"{D1}\" presName=\"diagram\" presStyleCnt=\"0\"><dgm:presLayoutVars><dgm:dir/><dgm:resizeHandles val=\"exact\"/></dgm:presLayoutVars></dgm:prSet><dgm:spPr/></dgm:pt>")
        pts = (pts + "<dgm:pt modelId=\"{R1}\" type=\"pres\"><dgm:prSet presAssocID=\"{N1}\" presName=\"node\" presStyleLbl=\"node1\" presStyleIdx=\"0\" presStyleCnt=\"1\"/><dgm:spPr/></dgm:pt>")
        def cs:string "<dgm:cxn modelId=\"{C1}\" srcId=\"{D1}\" destId=\"{N1}\" srcOrd=\"0\" destOrd=\"0\" parTransId=\"{P1}\" sibTransId=\"{S1}\"/>"
        cs = (cs + "<dgm:cxn modelId=\"{X1}\" type=\"presOf\" srcId=\"{N1}\" destId=\"{R1}\" srcOrd=\"0\" destOrd=\"0\" presId=\"{R0}\"/>")
        cs = (cs + "<dgm:cxn modelId=\"{X2}\" type=\"presParOf\" srcId=\"{R0}\" destId=\"{R1}\" srcOrd=\"0\" destOrd=\"0\" presId=\"{R0}\"/>")
        def ext:string "<dgm:bg/><dgm:whole/><dgm:extLst><a:ext uri=\"http://schemas.microsoft.com/office/drawing/2008/diagram\"><dsp:dataModelExt xmlns:dsp=\"http://schemas.microsoft.com/office/drawing/2008/diagram\" relId=\"rId6\" minVer=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\"/></a:ext></dgm:extLst>"
        return ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" + (SaDataTest.open()) + "<dgm:ptLst>" + pts + "</dgm:ptLst><dgm:cxnLst>" + cs + "</dgm:cxnLst>" + ext + "</dgm:dataModel>")
    }

    sfn testPowerPoint:void (c:SaCheck) {
        print "-- a file PowerPoint wrote --"
        def r:SaReadResult (SaDataReader.read((SaDataTest.powerPointFile())))
        c.ok("it is read" r.ok)
        c.eqStr("with no error" r.error "")
        def m:SaModel r.model
        c.eqStr("its drawing relationship" m.drawingRelId "rId6")
        def dp:SaPoint (m.doc())
        c.eqStr("its quick style" dp.styleId "urn:microsoft.com/office/officeart/2005/8/quickstyle/simple1")
        c.eqStr("its colours" dp.colorsId "urn:microsoft.com/office/officeart/2005/8/colors/accent1_2")
        c.eqInt("two presentation points" (m.countOf("pres")) 2)
        c.eqStr("the outline ignores everything but content" (m.outline()) "One\n")
        def rp:SaPoint (SaDataTest.pt(m "{R1}"))
        c.eqStr("presName" rp.presName "node")
        c.eqStr("presStyleLbl" rp.presStyleLbl "node1")
        c.eqInt("presStyleIdx" rp.presStyleIdx 0)
        c.eqInt("presStyleCnt" rp.presStyleCnt 1)
        c.eqStr("presAssocID" rp.presAssocId "{N1}")
        def x1:SaCxn (unwrap (m.cxnById("{X1}")))
        c.eqStr("presOf is read" x1.type "presOf")
        c.eqStr("with its presId" x1.presId "{R0}")
        def c1:SaCxn (unwrap (m.cxnById("{C1}")))
        c.eqStr("parOf keeps its transitions" (c1.parTransId + " " + c1.sibTransId) "{P1} {S1}")
        ; complete() has nothing to add to a complete file
        def before:int (array_length m.points)
        m.complete()
        c.eqInt("complete adds nothing to a complete file" (array_length m.points) before)
    }

    sfn testComplete:void (c:SaCheck) {
        print "-- what a file leaves out --"
        def r:SaReadResult (SaDataReader.read((SaDataTest.minimal())))
        def m:SaModel r.model
        m.complete()
        c.eqInt("a parent and a sibling transition per connection" (m.countOf("parTrans") + m.countOf("sibTrans")) 6)
        def c0:SaCxn (itemAt m.cxns 0)
        c.eqStr("derived from the connection's id" c0.parTransId "10-parTrans")
        c.eqStr("the sibling one too" c0.sibTransId "10-sibTrans")
        def t:SaPoint (SaDataTest.pt(m "10-parTrans"))
        c.eqStr("which names its connection" t.cxnId "10")
        def n:int (array_length m.points)
        m.complete()
        c.eqInt("complete twice is complete once" (array_length m.points) n)
        ; connections without ids get ids, and they do not collide
        def pts:string ((SaDataTest.doc()) + (SaDataTest.node("cxn-0-1" "taken")) + (SaDataTest.node("1" "A")))
        def cs:string "<dgm:cxn srcId=\"0\" destId=\"cxn-0-1\"/><dgm:cxn srcId=\"0\" destId=\"1\"/>"
        def r2:SaReadResult (SaDataReader.read((SaDataTest.file(pts cs))))
        r2.model.complete()
        def k:SaCxn (itemAt r2.model.cxns 1)
        c.eqStr("an id another point has is not reused" k.id "cxn-0-1-2")
        c.ok("the model is still valid after complete" ((SaDataReader.checkShape(r2.model)) == ""))
    }

    sfn testRefusals:void (c:SaCheck) {
        print "-- refusals --"
        def d:string (SaDataTest.doc())
        def n1:string (SaDataTest.node("1" "A"))
        def c1:string (SaDataTest.cxn("c" "0" "1" 0))
        c.refused("nothing at all" "" "not XML")
        c.refused("a different root" "<a:p/>" "not <dgm:dataModel>")
        c.refused("no point list" ((SaDataTest.open()) + "</dgm:dataModel>") "ptLst> is missing")
        c.refused("a point with no id" (SaDataTest.file((d + "<dgm:pt/>") "")) "point 2: modelId is missing")
        c.refused("an empty id" (SaDataTest.file((d + "<dgm:pt modelId=\" \"/>") "")) "modelId is empty")
        c.refused("an id used twice" (SaDataTest.file((d + n1 + n1) "")) "point 1: modelId is used twice")
        c.refused("a type that does not exist" (SaDataTest.file((d + "<dgm:pt modelId=\"1\" type=\"nod\"/>") "")) "type \"nod\" is not one of")
        c.refused("a transition without its connection" (SaDataTest.file((d + "<dgm:pt modelId=\"t\" type=\"parTrans\"/>") "")) "needs cxnId")
        c.refused("a transition naming no connection" (SaDataTest.file((d + n1 + "<dgm:pt modelId=\"t\" type=\"sibTrans\" cxnId=\"zz\"/>") c1)) "cxnId \"zz\" names no connection")
        c.refused("presStyleIdx not a number" (SaDataTest.file((d + "<dgm:pt modelId=\"r\" type=\"pres\"><dgm:prSet presStyleIdx=\"x\"/></dgm:pt>") "")) "presStyleIdx is not a whole number")
        c.refused("a connection type that does not exist" (SaDataTest.file((d + n1) "<dgm:cxn modelId=\"c\" type=\"childOf\" srcId=\"0\" destId=\"1\"/>")) "type \"childOf\" is not one of")
        c.refused("no srcId" (SaDataTest.file((d + n1) "<dgm:cxn destId=\"1\"/>")) "srcId is missing")
        c.refused("no destId" (SaDataTest.file((d + n1) "<dgm:cxn srcId=\"0\"/>")) "destId is missing")
        c.refused("srcId naming nothing" (SaDataTest.file((d + n1) (SaDataTest.cxn("c" "9" "1" 0)))) "srcId \"9\" names no point")
        c.refused("destId naming nothing" (SaDataTest.file((d + n1) (SaDataTest.cxn("c" "0" "9" 0)))) "destId \"9\" names no point")
        c.refused("a point under itself" (SaDataTest.file((d + n1) (SaDataTest.cxn("c" "1" "1" 0)))) "connected to itself")
        c.refused("srcOrd not a number" (SaDataTest.file((d + n1) "<dgm:cxn srcId=\"0\" destId=\"1\" srcOrd=\"first\"/>")) "srcOrd is not a whole number")
        c.refused("destOrd not a number" (SaDataTest.file((d + n1) "<dgm:cxn srcId=\"0\" destId=\"1\" destOrd=\"-\"/>")) "destOrd is not a whole number")
        c.refused("a connection id used twice" (SaDataTest.file((d + n1 + (SaDataTest.node("2" "B"))) (c1 + (SaDataTest.cxn("c" "0" "2" 1))))) "connection c: modelId is used twice")
        c.refused("a connection id that is a point's" (SaDataTest.file((d + n1) (SaDataTest.cxn("1" "0" "1" 0)))) "also a point's")
        c.refused("no document point" (SaDataTest.file(n1 "")) "no document point")
        c.refused("two document points" (SaDataTest.file((d + "<dgm:pt modelId=\"9\" type=\"doc\"/>") "")) "2 document points")
        c.refused("a transition as a parent" (SaDataTest.file((d + n1 + "<dgm:pt modelId=\"t\" type=\"parTrans\" cxnId=\"c\"/>") (c1 + (SaDataTest.cxn("d" "t" "1" 0))))) "parTrans point cannot be a parent")
        c.refused("the document as a child" (SaDataTest.file((d + n1) (SaDataTest.cxn("c" "1" "0" 0)))) "doc point cannot be a child")
        c.refused("two parents" (SaDataTest.file((d + n1 + (SaDataTest.node("2" "B"))) (c1 + (SaDataTest.cxn("e" "0" "2" 1)) + (SaDataTest.cxn("f" "1" "2" 0))))) "point 2 has two parents (0 and 1)")
        c.refused("a node under nothing" (SaDataTest.file((d + n1 + (SaDataTest.node("2" "B"))) c1)) "point 2 is not under the document")
        c.refused("a cycle off to one side" (SaDataTest.file((d + n1 + (SaDataTest.node("2" "B")) + (SaDataTest.node("3" "C"))) (c1 + (SaDataTest.cxn("e" "2" "3" 0)) + (SaDataTest.cxn("f" "3" "2" 0))))) "is not under the document")
        c.refused("a list written as text" "- Plan\n- Build\n- Ship\n" "not XML")
    }

    sfn testWriter:void (c:SaCheck) {
        print "-- written and read back --"
        def r:SaReadResult (SaDataReader.read((SaDataTest.minimal())))
        def xml:string (SaDataWriter.write(r.model))
        def back:SaReadResult (SaDataReader.read(xml))
        c.ok("what is written is read" back.ok)
        c.eqStr("the same outline" (back.model.outline()) (r.model.outline()))
        c.eqStr("the same layout" (back.model.layoutId()) (r.model.layoutId()))
        c.ok("a node's type is not written" ((indexOf xml "type=\"node\"") < 0))
        c.ok("a parOf's type is not written" ((indexOf xml "type=\"parOf\"") < 0))
        c.ok("the document's type is" ((indexOf xml "type=\"doc\"") >= 0))
        c.ok("srcOrd is always written" ((indexOf xml "srcOrd=\"2\"") >= 0))
        c.ok("an XML declaration first" ((indexOf xml "<?xml") == 0))

        def full:SaReadResult (SaDataReader.read((SaDataTest.powerPointFile())))
        def xml2:string (SaDataWriter.write(full.model))
        def back2:SaReadResult (SaDataReader.read(xml2))
        c.ok("PowerPoint's file round-trips" back2.ok)
        c.eqStr("its drawing link survives" back2.model.drawingRelId "rId6")
        c.eqInt("its points survive" (array_length back2.model.points) (array_length full.model.points))
        c.eqInt("its connections survive" (array_length back2.model.cxns) (array_length full.model.cxns))
        def rp:SaPoint (SaDataTest.pt(back2.model "{R1}"))
        c.eqStr("a presentation point's label survives" (rp.presStyleLbl + " " + (to_string rp.presStyleIdx) + "/" + (to_string rp.presStyleCnt)) "node1 0/1")
        def x1:SaCxn (unwrap (back2.model.cxnById("{X2}")))
        c.eqStr("presParOf survives" (x1.type + " " + x1.presId) "presParOf {R0}")

        ; text with everything SaRun holds, and characters XML cares about
        def pts:string ((SaDataTest.doc()) + "<dgm:pt modelId=\"1\"><dgm:t><a:p><a:r><a:rPr sz=\"2400\" b=\"1\" i=\"1\"><a:solidFill><a:srgbClr val=\"00AA00\"/></a:solidFill></a:rPr><a:t>a &lt;b&gt; &amp; &quot;c&quot;</a:t></a:r></a:p><a:p><a:pPr lvl=\"2\"/><a:r><a:t>deep</a:t></a:r></a:p></dgm:t></dgm:pt>")
        def r3:SaReadResult (SaDataReader.read((SaDataTest.file(pts (SaDataTest.cxn("c" "0" "1" 0))))))
        def back3:SaReadResult (SaDataReader.read((SaDataWriter.write(r3.model))))
        def p:SaPoint (SaDataTest.pt(back3.model "1"))
        def para0:SaPara (itemAt p.paras 0)
        def run:SaRun (itemAt para0.runs 0)
        c.eqStr("escaped text comes back" run.text "a <b> & \"c\"")
        c.ok("bold, italic and 24 pt come back" ((run.bold && run.italic) && ((run.sizePt > 23.99) && (run.sizePt < 24.01))))
        c.eqStr("the colour comes back" run.color "00AA00")
        def para1:SaPara (itemAt p.paras 1)
        c.eqInt("the level comes back" para1.level 2)

        ; completed, written, read: the transitions are in the file
        r.model.complete()
        def back4:SaReadResult (SaDataReader.read((SaDataWriter.write(r.model))))
        c.ok("a completed model is a valid file" back4.ok)
        c.eqInt("with its six transitions" (back4.model.countOf("parTrans") + back4.model.countOf("sibTrans")) 6)
        def k4:SaCxn (itemAt back4.model.cxns 0)
        c.eqStr("which the connection names" k4.sibTransId "10-sibTrans")
    }

    sfn main:void () {
        print "== SaDataTest =="
        def c (new SaCheck())
        SaDataTest.testMinimal(c)
        SaDataTest.testOrder(c)
        SaDataTest.testTree(c)
        SaDataTest.testText(c)
        SaDataTest.testPowerPoint(c)
        SaDataTest.testComplete(c)
        SaDataTest.testRefusals(c)
        SaDataTest.testWriter(c)
        print ""
        print ("passed = " + (to_string c.passed) + "  failed = " + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}
