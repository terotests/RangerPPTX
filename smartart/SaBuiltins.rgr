        s = (s + "<dgm:param type=\"linDir\" val=\"fromR\"/></dgm:alg></dgm:else></dgm:choose><dgm:shape/><dgm:constrLst><dgm:constr type=\"w\" for=\"ch\" forName=\"node\" refType=\"w\"/>")
        s = (s + "<dgm:constr type=\"h\" for=\"ch\" forName=\"node\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.6\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"sibTrans\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.21\"/>")
        s = (s + "<dgm:constr type=\"h\" for=\"ch\" forName=\"sibTrans\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.26\"/>")
        s = (s + "<dgm:constr type=\"sibSp\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.1\"/><dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"node\" op=\"equ\" val=\"65\"/>")
        s = (s + "</dgm:constrLst><dgm:forEach name=\"steps\" axis=\"ch\" ptType=\"node\"><dgm:layoutNode name=\"node\" styleLbl=\"node1\"><dgm:varLst><dgm:bulletEnabled val=\"1\"/>")
        s = (s + "</dgm:varLst><dgm:alg type=\"tx\"/><dgm:shape type=\"roundRect\"><dgm:adjLst><dgm:adj idx=\"1\" val=\"0.1\"/></dgm:adjLst></dgm:shape>")
        s = (s + "<dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/><dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"primFontSz\" fact=\"0.3\"/>")
        s = (s + "<dgm:constr type=\"bMarg\" refType=\"primFontSz\" fact=\"0.3\"/><dgm:constr type=\"lMarg\" refType=\"primFontSz\" fact=\"0.3\"/>")
        s = (s + "<dgm:constr type=\"rMarg\" refType=\"primFontSz\" fact=\"0.3\"/></dgm:constrLst><dgm:ruleLst><dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst>")
        s = (s + "</dgm:layoutNode><dgm:forEach name=\"arrows\" axis=\"followSib\" ptType=\"sibTrans\" cnt=\"1\"><dgm:layoutNode name=\"sibTrans\" styleLbl=\"sibTrans2D1\">")
        s = (s + "<dgm:alg type=\"conn\"/><dgm:shape type=\"conn\"><dgm:adjLst><dgm:adj idx=\"1\" val=\"0.6\"/><dgm:adj idx=\"2\" val=\"0.5\"/></dgm:adjLst></dgm:shape></dgm:layoutNode>")
        s = (s + "</dgm:forEach></dgm:forEach></dgm:layoutNode></dgm:layoutDef>")
        return s
    }

    sfn pyramid1:string () {
        def s:string ""
        s = (s + "<dgm:layoutDef xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" uniqueId=\"urn:microsoft.com/office/officeart/2005/8/layout/pyramid1\">")
        s = (s + "<dgm:title val=\"Basic Pyramid\"/><dgm:layoutNode name=\"pyramid\"><dgm:varLst><dgm:dir/><dgm:resizeHandles val=\"exact\"/></dgm:varLst><dgm:choose name=\"direction\">")
        s = (s + "<dgm:if name=\"forward\" func=\"var\" arg=\"dir\" op=\"equ\" val=\"norm\"><dgm:alg type=\"pyra\"><dgm:param type=\"linDir\" val=\"fromT\"/>")
        s = (s + "<dgm:param type=\"pyraLvlNode\" val=\"level\"/></dgm:alg></dgm:if><dgm:else name=\"backward\"><dgm:alg type=\"pyra\"><dgm:param type=\"linDir\" val=\"fromB\"/>")
        s = (s + "<dgm:param type=\"pyraLvlNode\" val=\"level\"/></dgm:alg></dgm:else></dgm:choose><dgm:shape/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"level\" op=\"equ\" val=\"65\"/></dgm:constrLst><dgm:forEach name=\"levels\" axis=\"ch\" ptType=\"node\">")
        s = (s + "<dgm:layoutNode name=\"level\" styleLbl=\"node1\"><dgm:varLst><dgm:bulletEnabled val=\"1\"/></dgm:varLst><dgm:alg type=\"tx\"/><dgm:shape type=\"trapezoid\"/>")
        s = (s + "<dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/><dgm:ruleLst><dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst></dgm:layoutNode></dgm:forEach>")
        s = (s + "</dgm:layoutNode></dgm:layoutDef>")
        return s
    }

    sfn radial1:string () {
        def s:string ""
        s = (s + "<dgm:layoutDef xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" uniqueId=\"urn:microsoft.com/office/officeart/2005/8/layout/radial1\">")
        s = (s + "<dgm:title val=\"Basic Radial\"/><dgm:layoutNode name=\"radial\"><dgm:varLst><dgm:dir/><dgm:resizeHandles val=\"exact\"/></dgm:varLst><dgm:alg type=\"cycle\">")
        s = (s + "<dgm:param type=\"stAng\" val=\"0\"/><dgm:param type=\"spanAng\" val=\"360\"/><dgm:param type=\"ctrShpMap\" val=\"fNode\"/></dgm:alg><dgm:shape/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"centerShape\" refType=\"w\" fact=\"0.26\"/>")
        s = (s + "<dgm:constr type=\"h\" for=\"ch\" forName=\"centerShape\" refType=\"w\" refFor=\"ch\" refForName=\"centerShape\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"node\" refType=\"w\" refFor=\"ch\" refForName=\"centerShape\" fact=\"0.72\"/>")
        s = (s + "<dgm:constr type=\"h\" for=\"ch\" forName=\"node\" refType=\"w\" refFor=\"ch\" refForName=\"node\"/>")
        s = (s + "<dgm:constr type=\"sibSp\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.2\"/><dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"centerShape\" op=\"equ\" val=\"65\"/>")
        s = (s + "<dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"node\" op=\"equ\" val=\"65\"/></dgm:constrLst><dgm:forEach name=\"centre\" axis=\"ch\" ptType=\"node\" cnt=\"1\">")
        s = (s + "<dgm:layoutNode name=\"centerShape\" styleLbl=\"node0\"><dgm:alg type=\"tx\"/><dgm:shape type=\"ellipse\"/><dgm:presOf axis=\"self\"/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"tMarg\" refType=\"w\" fact=\"0.15\"/><dgm:constr type=\"bMarg\" refType=\"w\" fact=\"0.15\"/><dgm:constr type=\"lMarg\" refType=\"w\" fact=\"0.15\"/>")
        s = (s + "<dgm:constr type=\"rMarg\" refType=\"w\" fact=\"0.15\"/></dgm:constrLst><dgm:ruleLst><dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst>")
        s = (s + "</dgm:layoutNode><dgm:forEach name=\"spokes\" axis=\"ch\" ptType=\"node\"><dgm:forEach name=\"spoke\" axis=\"precedSib\" ptType=\"parTrans\" cnt=\"1\">")
        s = (s + "<dgm:layoutNode name=\"parTrans\" styleLbl=\"parChTrans1D2\"><dgm:alg type=\"conn\"><dgm:param type=\"dim\" val=\"1D\"/><dgm:param type=\"endSty\" val=\"noArr\"/></dgm:alg>")
        s = (s + "<dgm:shape type=\"conn\"/></dgm:layoutNode></dgm:forEach><dgm:layoutNode name=\"node\" styleLbl=\"node1\"><dgm:varLst><dgm:bulletEnabled val=\"1\"/></dgm:varLst>")
        s = (s + "<dgm:alg type=\"tx\"/><dgm:shape type=\"ellipse\"/><dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/><dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"w\" fact=\"0.15\"/>")
        s = (s + "<dgm:constr type=\"bMarg\" refType=\"w\" fact=\"0.15\"/><dgm:constr type=\"lMarg\" refType=\"w\" fact=\"0.15\"/><dgm:constr type=\"rMarg\" refType=\"w\" fact=\"0.15\"/>")
        s = (s + "</dgm:constrLst><dgm:ruleLst><dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst></dgm:layoutNode></dgm:forEach></dgm:forEach>")
        s = (s + "</dgm:layoutNode></dgm:layoutDef>")
        return s
    }

    sfn vList2:string () {
        def s:string ""
        s = (s + "<dgm:layoutDef xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" uniqueId=\"urn:microsoft.com/office/officeart/2005/8/layout/vList2\">")
        s = (s + "<dgm:title val=\"Vertical Bullet List\"/><dgm:layoutNode name=\"linear\"><dgm:varLst><dgm:animLvl val=\"lvl\"/><dgm:resizeHandles val=\"exact\"/></dgm:varLst>")
        s = (s + "<dgm:alg type=\"lin\"><dgm:param type=\"linDir\" val=\"fromT\"/><dgm:param type=\"nodeHorzAlign\" val=\"l\"/></dgm:alg><dgm:shape/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"parentText\" refType=\"w\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"parentText\" refType=\"w\" fact=\"0.13\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"childText\" refType=\"w\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"childText\" refType=\"w\" fact=\"0.16\"/>")
        s = (s + "<dgm:constr type=\"sibSp\" refType=\"w\" fact=\"0.015\"/><dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"parentText\" op=\"equ\" val=\"65\"/>")
        s = (s + "<dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"childText\" op=\"equ\" val=\"65\"/>")
        s = (s + "<dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"childText\" refType=\"primFontSz\" refFor=\"ch\" refForName=\"parentText\" op=\"lte\" fact=\"0.78\"/></dgm:constrLst>")
        s = (s + "<dgm:forEach name=\"items\" axis=\"ch\" ptType=\"node\"><dgm:layoutNode name=\"parentText\" styleLbl=\"node1\"><dgm:alg type=\"tx\">")
        s = (s + "<dgm:param type=\"parTxLTRAlign\" val=\"l\"/></dgm:alg><dgm:shape type=\"roundRect\"><dgm:adjLst><dgm:adj idx=\"1\" val=\"0.16667\"/></dgm:adjLst></dgm:shape>")
        s = (s + "<dgm:presOf axis=\"self\"/><dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"primFontSz\" fact=\"0.3\"/><dgm:constr type=\"bMarg\" refType=\"primFontSz\" fact=\"0.3\"/>")
        s = (s + "<dgm:constr type=\"lMarg\" refType=\"primFontSz\" fact=\"0.3\"/><dgm:constr type=\"rMarg\" refType=\"primFontSz\" fact=\"0.3\"/></dgm:constrLst><dgm:ruleLst>")
        s = (s + "<dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst></dgm:layoutNode><dgm:choose name=\"hasPoints\">")
        s = (s + "<dgm:if name=\"some\" axis=\"ch\" ptType=\"node\" func=\"cnt\" op=\"gte\" val=\"1\"><dgm:layoutNode name=\"childText\" styleLbl=\"revTx\"><dgm:alg type=\"tx\">")
        s = (s + "<dgm:param type=\"txAnchorVert\" val=\"t\"/><dgm:param type=\"parTxLTRAlign\" val=\"l\"/></dgm:alg><dgm:shape type=\"rect\"/><dgm:presOf axis=\"des\" ptType=\"node\"/>")
        s = (s + "<dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"primFontSz\" fact=\"0.1\"/><dgm:constr type=\"bMarg\" refType=\"primFontSz\" fact=\"0.1\"/>")
        s = (s + "<dgm:constr type=\"lMarg\" refType=\"primFontSz\" fact=\"0.3\"/><dgm:constr type=\"rMarg\" refType=\"primFontSz\" fact=\"0.3\"/></dgm:constrLst><dgm:ruleLst>")
        s = (s + "<dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst></dgm:layoutNode></dgm:if><dgm:else name=\"none\"/></dgm:choose></dgm:forEach>")
        s = (s + "</dgm:layoutNode></dgm:layoutDef>")
        return s
    }
}
