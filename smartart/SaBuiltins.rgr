        s = (s + "</dgm:constrLst><dgm:forEach name=\"items\" axis=\"ch\" ptType=\"node\"><dgm:layoutNode name=\"node\" styleLbl=\"node1\"><dgm:varLst><dgm:bulletEnabled val=\"1\"/>")
        s = (s + "</dgm:varLst><dgm:alg type=\"tx\"/><dgm:shape type=\"ellipse\"/><dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/><dgm:constrLst>")
