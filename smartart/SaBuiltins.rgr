        s = (s + "<dgm:constr type=\"tMarg\" refType=\"primFontSz\" fact=\"0.15\"/><dgm:constr type=\"bMarg\" refType=\"primFontSz\" fact=\"0.15\"/>")
        s = (s + "<dgm:constr type=\"lMarg\" refType=\"h\" fact=\"0.5\"/><dgm:constr type=\"rMarg\" refType=\"h\" fact=\"0.3\"/></dgm:constrLst><dgm:ruleLst>")
        s = (s + "<dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst></dgm:layoutNode></dgm:forEach></dgm:layoutNode></dgm:layoutDef>")
