        s = (s + "<dgm:constr type=\"rMarg\" refType=\"w\" fact=\"0.15\"/></dgm:constrLst><dgm:ruleLst><dgm:rule type=\"primFontSz\" val=\"5\" fact=\"NaN\" max=\"NaN\"/></dgm:ruleLst>")
        s = (s + "</dgm:layoutNode><dgm:forEach name=\"arrows\" axis=\"followSib\" ptType=\"sibTrans\" hideLastTrans=\"0\" cnt=\"1\"><dgm:layoutNode name=\"sibTrans\" styleLbl=\"sibTrans2D1\">")
