        s = (s + "<dgm:constr type=\"l\" for=\"ch\" forName=\"text\" refType=\"w\" fact=\"0\"/><dgm:constr type=\"t\" for=\"ch\" forName=\"text\" refType=\"h\" fact=\"0.28\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"accent\" refType=\"h\" fact=\"0.42\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"accent\" refType=\"h\" fact=\"0.42\"/>")
        s = (s + "<dgm:constr type=\"l\" for=\"ch\" forName=\"accent\" refType=\"w\" fact=\"0.03\"/><dgm:constr type=\"t\" for=\"ch\" forName=\"accent\" refType=\"h\" fact=\"0\"/></dgm:constrLst>")
        s = (s + "<dgm:layoutNode name=\"text\" styleLbl=\"node1\"><dgm:alg type=\"tx\"></dgm:alg><dgm:shape type=\"roundRect\"/><dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/>")
        s = (s + "<dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"h\" fact=\"0.22\"/><dgm:constr type=\"bMarg\" refType=\"primFontSz\" fact=\"0.3\"/>")
