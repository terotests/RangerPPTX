        s = (s + "<dgm:alg type=\"lin\"><dgm:param type=\"linDir\" val=\"fromR\"/></dgm:alg></dgm:else></dgm:choose><dgm:shape/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"node\" refType=\"w\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"node\" refType=\"w\" refFor=\"ch\" refForName=\"node\" fact=\"0.4\"/>")
