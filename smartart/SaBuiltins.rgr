        s = (s + "<dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"childText\" refType=\"primFontSz\" refFor=\"ch\" refForName=\"parentText\" op=\"lte\" fact=\"0.78\"/></dgm:constrLst>")
