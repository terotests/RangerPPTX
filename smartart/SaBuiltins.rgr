        s = (s + "<dgm:alg type=\"snake\"><dgm:param type=\"grDir\" val=\"tL\"/><dgm:param type=\"flowDir\" val=\"row\"/><dgm:param type=\"contDir\" val=\"sameDir\"/>")
        s = (s + "<dgm:param type=\"off\" val=\"ctr\"/></dgm:alg><dgm:shape/><dgm:constrLst><dgm:constr type=\"w\" for=\"ch\" forName=\"cell\" refType=\"w\"/>")
