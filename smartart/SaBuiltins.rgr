    sfn funnel1:string () {
        def s:string ""
        s = (s + "<dgm:layoutDef xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" uniqueId=\"urn:microsoft.com/office/officeart/2005/8/layout/funnel1\">")
        s = (s + "<dgm:title val=\"Funnel\"/><dgm:layoutNode name=\"funnel\"><dgm:varLst><dgm:resizeHandles val=\"exact\"/></dgm:varLst><dgm:alg type=\"composite\"/><dgm:shape/>")
        s = (s + "<dgm:constrLst><dgm:constr type=\"w\" for=\"ch\" forName=\"shape\" refType=\"w\" fact=\"0.5\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"shape\" refType=\"h\" fact=\"0.62\"/>")
        s = (s + "<dgm:constr type=\"t\" for=\"ch\" forName=\"shape\" refType=\"h\" fact=\"0\"/><dgm:constr type=\"ctrX\" for=\"ch\" forName=\"shape\" refType=\"w\" fact=\"0.5\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"mouth\" refType=\"w\" fact=\"0.38\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"mouth\" refType=\"h\" fact=\"0.22\"/>")
        s = (s + "<dgm:constr type=\"t\" for=\"ch\" forName=\"mouth\" refType=\"h\" fact=\"0.06\"/><dgm:constr type=\"ctrX\" for=\"ch\" forName=\"mouth\" refType=\"w\" fact=\"0.5\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"arrow\" refType=\"w\" fact=\"0.05\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"arrow\" refType=\"h\" fact=\"0.1\"/>")
        s = (s + "<dgm:constr type=\"t\" for=\"ch\" forName=\"arrow\" refType=\"h\" fact=\"0.65\"/><dgm:constr type=\"ctrX\" for=\"ch\" forName=\"arrow\" refType=\"w\" fact=\"0.5\"/>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"result\" refType=\"w\" fact=\"0.36\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"result\" refType=\"h\" fact=\"0.2\"/>")
        s = (s + "<dgm:constr type=\"t\" for=\"ch\" forName=\"result\" refType=\"h\" fact=\"0.78\"/><dgm:constr type=\"ctrX\" for=\"ch\" forName=\"result\" refType=\"w\" fact=\"0.5\"/>")
        s = (s + "<dgm:constr type=\"primFontSz\" for=\"des\" forName=\"item\" op=\"equ\" val=\"65\"/><dgm:constr type=\"primFontSz\" for=\"ch\" forName=\"result\" op=\"equ\" val=\"65\"/>")
        s = (s + "</dgm:constrLst><dgm:layoutNode name=\"shape\" styleLbl=\"alignAcc1\"><dgm:alg type=\"tx\"/><dgm:shape type=\"funnel\"/></dgm:layoutNode><dgm:layoutNode name=\"mouth\">")
        s = (s + "<dgm:alg type=\"snake\"><dgm:param type=\"off\" val=\"ctr\"/></dgm:alg><dgm:shape/><dgm:constrLst>")
        s = (s + "<dgm:constr type=\"w\" for=\"ch\" forName=\"item\" refType=\"h\" fact=\"0.9\"/><dgm:constr type=\"h\" for=\"ch\" forName=\"item\" refType=\"h\" fact=\"0.9\"/>")
        s = (s + "<dgm:constr type=\"sibSp\" refType=\"w\" fact=\"0.02\"/></dgm:constrLst><dgm:forEach name=\"poured\" axis=\"ch\" ptType=\"node\"><dgm:choose name=\"notLast\">")
        s = (s + "<dgm:if name=\"poured\" func=\"revPos\" op=\"gt\" val=\"1\"><dgm:layoutNode name=\"item\" styleLbl=\"node1\"><dgm:alg type=\"tx\"></dgm:alg><dgm:shape type=\"ellipse\"/>")
        s = (s + "<dgm:presOf axis=\"desOrSelf\" ptType=\"node\"/><dgm:constrLst><dgm:constr type=\"tMarg\" refType=\"w\" fact=\"0.12\"/><dgm:constr type=\"bMarg\" refType=\"w\" fact=\"0.12\"/>")
        s = (s + "<dgm:constr type=\"lMarg\" refType=\"w\" fact=\"0.12\"/><dgm:constr type=\"rMarg\" refType=\"w\" fact=\"0.12\"/></dgm:constrLst><dgm:ruleLst>")
