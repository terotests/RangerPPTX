        s = (s + "<dgm:constr type=\"sibSp\" refType=\"w\" fact=\"0.02\"/></dgm:constrLst><dgm:forEach name=\"texts\" axis=\"ch\" ptType=\"node\" cnt=\"4\"><dgm:choose name=\"position\">")
