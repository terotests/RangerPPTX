; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaLayoutDef — a SmartArt layout definition, as data
; ==============================================================================
;
; `dgm:layoutDef` is a small program. Its `layoutNode`s are the shapes a
; diagram may have; `forEach` repeats what it holds once per data point it
; walks to; `choose`/`if`/`else` pick one branch by a test on the data; each
; layout node says which algorithm places its children (`alg`), what its own
; geometry is (`shape`), which data point's text it shows (`presOf`), how big
; things are (`constrLst`) and what may give way when the text does not fit
; (`ruleLst`).
;
; This file is only the program's text, read into objects. Running it against
; a data model is `SaPresTree`; sizing is `SaConstraints`; placing is the
; algorithms.
;
; Attributes the specification types as LISTS — `axis`, `ptType`, `st`,
; `cnt`, `step`, `hideLastTrans` — are lists here too: `axis="ch ch"` is two
; steps, children of children, and `ptType="node node"` filters each step.
; ==============================================================================

class SaParam {
    def name:string ""
    def value:string ""

    Constructor () {
    }
}

; A walk from the current data point: `forEach`, `presOf` and `if` all use it.
class SaIter {
    def axis:[string]
    def ptType:[string]
    def st:[int]
    def cnt:[int]
    def step:[int]
    def hideLastTrans:[boolean]

    Constructor () {
    }

    ; the value for step i, or the default when the list is shorter
    fn axisAt:string (i:int) {
        if (i < (array_length axis)) {
            return (itemAt axis i)
        }
        return "none"
    }

    fn ptTypeAt:string (i:int) {
        if (i < (array_length ptType)) {
            return (itemAt ptType i)
        }
        if ((array_length ptType) > 0) {
            return (itemAt ptType ((array_length ptType) - 1))
        }
        return "all"
    }

    fn stAt:int (i:int) {
        if (i < (array_length st)) {
            return (itemAt st i)
        }
        return 1
    }

    fn cntAt:int (i:int) {
        if (i < (array_length cnt)) {
            return (itemAt cnt i)
        }
        return 0
    }

    fn stepAt:int (i:int) {
        if (i < (array_length step)) {
            return (itemAt step i)
        }
        return 1
    }

    fn hideLastTransAt:boolean (i:int) {
        if (i < (array_length hideLastTrans)) {
            return (itemAt hideLastTrans i)
        }
        return true
    }

    fn steps:int () {
        return (array_length axis)
    }
}

class SaAlgDef {
    ; composite conn cycle hierChild hierRoot pyra lin sp tx snake
    def type:string ""
    def params:[SaParam]

    Constructor () {
    }

    fn param:string (name:string fallback:string) {
        def i:int 0
        while (i < (array_length params)) {
            def p:SaParam (itemAt params i)
            if (p.name == name) {
                return p.value
            }
            i = (i + 1)
        }
        return fallback
    }
}

class SaShapeDef {
    ; a preset geometry name, "none", or "conn" (the connector the conn
    ; algorithm draws)
    def type:string "none"
    def rot:double 0.0
    def zOrderOff:int 0
    def hideGeom:boolean false
    def lkTxEntry:boolean false
    ; adjust values by `idx` (1-based in the file, stored at idx-1); NaN-free:
    ; `adjSet` says which were given
    def adj:[double]
    def adjSet:[boolean]

    Constructor () {
    }

    fn setAdj:void (idx:int v:double) {
        while ((array_length adj) < idx) {
            push adj 0.0
            push adjSet false
        }
        set adj (idx - 1) v
        set adjSet (idx - 1) true
    }
}

class SaConstr {
    def type:string "none"
    ; self ch des
    def forRel:string "self"
    def forName:string ""
    def ptType:string "all"
    def refType:string "none"
    def refFor:string "self"
    def refForName:string ""
    def refPtType:string "all"
    ; none equ gte lte
    def op:string "none"
    def val:double 0.0
    def hasVal:boolean false
    def fact:double 1.0
    def hasFact:boolean false

    Constructor () {
    }
}

class SaRule {
    def type:string "none"
    def forRel:string "self"
    def forName:string ""
    def ptType:string "all"
    ; each of these may be left out (the file's "NaN")
    def val:double 0.0
    def hasVal:boolean false
    def fact:double 0.0
    def hasFact:boolean false
    def max:double 0.0
    def hasMax:boolean false

    Constructor () {
    }
}

; One element of the program: a layoutNode, a forEach, a choose, or one of a
; choose's branches (if / else). They share a body: the children, in order.
class SaLoNode {
    ; layoutNode forEach choose if else
    def kind:string "layoutNode"
    def name:string ""

    ; layoutNode
    def styleLbl:string ""
    ; b (bottom first) or t
    def chOrder:string "b"
    def moveWith:string ""
    def hasAlg:boolean false
    def alg:SaAlgDef (new SaAlgDef())
    def hasShape:boolean false
    def shape:SaShapeDef (new SaShapeDef())
    def hasPresOf:boolean false
    def presOf:SaIter (new SaIter())
    def constrs:[SaConstr]
    def rules:[SaRule]
    def vars:[SaParam]

    ; forEach (and if): the walk
    def iter:SaIter (new SaIter())
    ; forEach: another forEach, by name, to run in its place
    def ref:string ""

    ; if
    def func:string ""
    def arg:string ""
    def op:string ""
    def val:string ""

    def children:[SaLoNode]

    Constructor () {
    }

    fn varValue:string (name:string fallback:string) {
        def i:int 0
        while (i < (array_length vars)) {
            def p:SaParam (itemAt vars i)
            if (p.name == name) {
                return p.value
            }
            i = (i + 1)
        }
        return fallback
    }
}

class SaLayoutDef {
    def uniqueId:string ""
    def title:string ""
    def root:SaLoNode (new SaLoNode())

    Constructor () {
    }

    ; the forEach called `name` anywhere in the program, for `ref`
    fn forEachNamed@(optional):SaLoNode (name:string) {
        return (SaLayoutDef.findIn(root name))
    }

    sfn findIn@(optional):SaLoNode (n:SaLoNode name:string) {
        if ((n.kind == "forEach") && (n.name == name)) {
            def hit@(optional):SaLoNode n
            return hit
        }
        def i:int 0
        while (i < (array_length n.children)) {
            def c:SaLoNode (itemAt n.children i)
            def f@(optional):SaLoNode (SaLayoutDef.findIn(c name))
            if (!null? f) {
                return f
            }
            i = (i + 1)
        }
        def none@(optional):SaLoNode
        return none
    }

    ; the short name: the last segment of the uniqueId
    fn shortId:string () {
        return (SaLayoutDef.shortOf(uniqueId))
    }

    sfn shortOf:string (id:string) {
        def at:int (lastIndexOf id "/")
        if (at < 0) {
            return id
        }
        return (substring id (at + 1) (strlen id))
    }
}
