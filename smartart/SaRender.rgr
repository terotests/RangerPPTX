; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaRender — a laid-out diagram, in a host's colours, into a display list
; ==============================================================================
;
; The engine's shapes name THEME colours (accent1, lt1, tx1, with a tint),
; because that is what a SmartArt in a deck means. A host that is not a
; PowerPoint deck — Sliqtly's slides — has its own palette, so it says what
; each name is (`SaPalette`), the colours are resolved with DrawingML's own
; tint and shade arithmetic (PptxResolver.applyMods), and the group is drawn
; by the same painter the deck editor uses (PptxToEvg), in the host's units:
; one unit is one point, which is what the engine laid it out in.
;
;   def pal (new SaPalette())
;   pal.set("accent1" "#1F6FEB")  ...
;   SaRender.paint(out res.shape pal x y)
;
; A colour set names light 1 and dark 1 for the text, which assumes the
; light background PowerPoint's own themes have. On a dark slide the host's
; light 1 is its dark paper and dark 1 its light ink, so a pale fill (a list
; column's tint of an accent) would carry pale text. `keepReadable` gives text
; that does not stand out from what it is drawn on (under 3:1, WCAG's large
; text) whichever of the two reads better there; `shadowsOn` casts a quick
; style's shadows in the ink on such a slide, where black would not show.
;
; A host that measured with its fonts (SaMeasure.over) draws with
; `drawWith(out res.shape x y res.measure)`, so the lines break where the
; engine measured them.
; ==============================================================================

Import "SaEngine.rgr"
Import "SaPresets.rgr"
Import "../src/PptxResolver.rgr"
Import "../src/PptxToEvg.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EvgTraceColor.rgr"

class SaPalette {
    def names:[string]
    def hexes:[string]

    Constructor () {
    }

    ; `hex` with or without the #, six digits
    fn set:void (name:string hex:string) {
        def h:string (to_uppercase hex)
        if ((indexOf h "#") == 0) {
            h = (substring h 1 (strlen h))
        }
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                set hexes i h
                return
            }
            i = (i + 1)
        }
        push names name
        push hexes h
    }

    ; the hex for a scheme name; tx1/bg1/tx2/bg2 are dk1/lt1/dk2/lt2
    fn hexOf:string (name:string) {
        def n:string name
        if (n == "tx1") { n = "dk1" }
        if (n == "bg1") { n = "lt1" }
        if (n == "tx2") { n = "dk2" }
        if (n == "bg2") { n = "lt2" }
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == n) {
                return (itemAt hexes i)
            }
            i = (i + 1)
        }
        ; what a theme with nothing said has
        if ((n == "lt1") || (n == "lt2")) {
            return "FFFFFF"
        }
        if ((n == "dk1") || (n == "dk2")) {
            return "000000"
        }
        return "4472C4"
    }
}

; The painter's text measurer, answering with the engine's SaMeasure: the
; painter breaks a shape's lines with the widths the engine fitted its size
; with, and names the family they were measured in. Without a host measurer
; it is the painter's own (the same 0.52 em guess).
class SaPaintMeasure extends OfficeTextMeasure {
    def sa:SaMeasure (new SaMeasure())

    Constructor () {
    }

    fn hasFamily@(override):boolean (fam:string) {
        return true
    }

    fn drawnFamily@(override):string (named:string bold:boolean italic:boolean) {
        if ((strlen named) > 0) {
            return named
        }
        if sa.hasHost {
            return sa.family
        }
        return family
    }

    fn widthOfIn@(override):double (text:string sizePx:double bold:boolean italic:boolean named:string) {
        return (sa.widthOf(text sizePx bold))
    }
}

class SaRender {

    sfn resolve:void (c:PptxColor pal:SaPalette) {
        if ((c.isSet == false) || (c.isScheme == false)) {
            return
        }
        c.srgb = (PptxResolver.applyMods((pal.hexOf(c.scheme)) c))
        c.isScheme = false
        c.tint = 0.0
        c.shade = 0.0
        c.lumMod = 1.0
        c.lumOff = 0.0
        c.satMod = 1.0
    }

    ; every colour in the group, resolved in place
    sfn resolveAll:void (s:PptxShape pal:SaPalette) {
        SaRender.resolve(s.fill pal)
        SaRender.resolve(s.line pal)
        def p:int 0
        while (p < (array_length s.text.paragraphs)) {
            def para:PptxParagraph (itemAt s.text.paragraphs p)
            def r:int 0
            while (r < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs r)
                SaRender.resolve(run.color pal)
                r = (r + 1)
            }
            p = (p + 1)
        }
        def i:int 0
        while (i < (array_length s.children)) {
            SaRender.resolveAll((itemAt s.children i) pal)
            i = (i + 1)
        }
    }

    ; --- text that reads on its ground -------------------------------------

    sfn hexByte:double (hex:string at:int) {
        def v:int 0
        def i:int at
        while (i < (at + 2)) {
            def ch:int (charAt (to_lowercase hex) i)
            def d:int 0
            if ((ch >= 48) && (ch <= 57)) {
                d = (ch - 48)
            }
            if ((ch >= 97) && (ch <= 102)) {
                d = ((ch - 97) + 10)
            }
            v = ((v * 16) + d)
            i = (i + 1)
        }
        return ((to_double v) / 255.0)
    }

    sfn channel:double (c:double) {
        if (c <= 0.03928) {
            return (c / 12.92)
        }
        return (EvgTraceColor.pow24(((c + 0.055) / 1.055)))
    }

    ; WCAG relative luminance of RRGGBB
    sfn luminance:double (hex:string) {
        if ((strlen hex) < 6) {
            return 0.0
        }
        def r:double (SaRender.channel((SaRender.hexByte(hex 0))))
        def g:double (SaRender.channel((SaRender.hexByte(hex 2))))
        def b:double (SaRender.channel((SaRender.hexByte(hex 4))))
        return (((0.2126 * r) + (0.7152 * g)) + (0.0722 * b))
    }

    sfn contrast:double (a:string b:string) {
        def la:double (SaRender.luminance(a))
        def lb:double (SaRender.luminance(b))
        if (la < lb) {
            def t:double la
            la = lb
            lb = t
        }
        return ((la + 0.05) / (lb + 0.05))
    }

    sfn twoHex:string (v:double) {
        def n:int (to_int ((v * 255.0) + 0.5))
        if (n < 0) { n = 0 }
        if (n > 255) { n = 255 }
        def digits:string "0123456789ABCDEF"
        def hi:int (to_int ((to_double n) / 16.0))
        def lo:int (n - (hi * 16))
        return ((substring digits hi (hi + 1)) + (substring digits lo (lo + 1)))
    }

    ; `top` at `alpha` over `under`
    sfn over:string (top:string alpha:double under:string) {
        if (alpha >= 1.0) {
            return top
        }
        def out:string ""
        def i:int 0
        while (i < 6) {
            def v:double (((SaRender.hexByte(top i)) * alpha) + ((SaRender.hexByte(under i)) * (1.0 - alpha)))
            out = (out + (SaRender.twoHex(v)))
            i = (i + 2)
        }
        return out
    }

    ; Every run's colour checked against what it is drawn on, and made
    ; light 1 or dark 1, whichever reads better, when it does not stand out.
    ; What is under the text is judged at points across its box: its own
    ; fill when the shape has one, else the last filled shape painted before
    ; it whose OUTLINE (not its box: an arrow's box is mostly the slide) holds
    ; the point, else `ground` (the slide). A label half on a pale arrow and
    ; half on a dark slide takes the colour that reads worst-case best.
    ; Colours must be resolved first (resolveAll).
    sfn keepReadable:void (s:PptxShape pal:SaPalette ground:string) {
        def painted:[PptxShape]
        def geo (new OfficePresetShapes())
        geo.load((SaPresets.text()))
        SaRender.readableIn(s pal ground painted geo)
    }

    ; the colour under (px, py): the topmost of `painted` that covers it,
    ; over the ground, or the ground
    sfn groundAt:string (painted:[PptxShape] px:double py:double ground:string geo:OfficePresetShapes) {
        def k:int ((array_length painted) - 1)
        while (k >= 0) {
            def b:PptxShape (itemAt painted k)
            if (SaRender.covers(b px py geo)) {
                return (SaRender.over(b.fill.srgb b.fill.alpha ground))
            }
            k = (k - 1)
        }
        return ground
    }

    ; the least contrast `c` has over the grounds
    sfn worst:double (c:string grounds:[string]) {
        def least:double 100.0
        def i:int 0
        while (i < (array_length grounds)) {
            def r:double (SaRender.contrast(c (itemAt grounds i)))
            if (r < least) {
                least = r
            }
            i = (i + 1)
        }
        return least
    }

    sfn readableIn:void (s:PptxShape pal:SaPalette ground:string painted:[PptxShape] geo:OfficePresetShapes) {
        def grounds:[string]
        if (SaRender.filled(s)) {
            push grounds (SaRender.over(s.fill.srgb s.fill.alpha ground))
        } {
            ; a grid of points across the text's box, inside its margins
            def x0:double (s.x + s.text.insetL)
            def y0:double (s.y + s.text.insetT)
            def tw:double ((s.width - s.text.insetL) - s.text.insetR)
            def th:double ((s.height - s.text.insetT) - s.text.insetB)
            if ((tw <= 0.0) || (th <= 0.0)) {
                x0 = s.x
                y0 = s.y
                tw = s.width
                th = s.height
            }
            def gy:int 0
            while (gy < 3) {
                def gx:int 0
                while (gx < 5) {
                    def px:double (x0 + (tw * (((to_double gx) + 0.5) / 5.0)))
                    def py:double (y0 + (th * (((to_double gy) + 0.5) / 3.0)))
                    push grounds (SaRender.groundAt(painted px py ground geo))
                    gx = (gx + 1)
                }
                gy = (gy + 1)
            }
        }
        def light:string (pal.hexOf("lt1"))
        def dark:string (pal.hexOf("dk1"))
        def best:string light
        if ((SaRender.worst(dark grounds)) > (SaRender.worst(light grounds))) {
            best = dark
        }
        def bestAt:double (SaRender.worst(best grounds))
        def p:int 0
        while (p < (array_length s.text.paragraphs)) {
            def para:PptxParagraph (itemAt s.text.paragraphs p)
            def r:int 0
            while (r < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs r)
                if (run.color.isSet && ((strlen run.color.srgb) >= 6)) {
                    def now:double (SaRender.worst(run.color.srgb grounds))
                    if ((now < 3.0) && (bestAt > now)) {
                        run.color.srgb = best
                    }
                }
                r = (r + 1)
            }
            p = (p + 1)
        }
        if (SaRender.filled(s)) {
            push painted s
        }
        def i:int 0
        while (i < (array_length s.children)) {
            SaRender.readableIn((itemAt s.children i) pal ground painted geo)
            i = (i + 1)
        }
    }

    ; A quick style's shadow (simple3 … simple5) is black, which on a dark
    ; slide is no different from the slide: the style would change nothing
    ; one can see. On a ground darker than mid-grey the shadow is cast in
    ; dark 1 instead (the host's ink, light on a dark slide), so the style
    ; still lifts the shapes off the page.
    sfn shadowsOn:void (s:PptxShape pal:SaPalette ground:string) {
        if ((SaRender.luminance(ground)) >= 0.18) {
            return
        }
        SaRender.inkShadows(s (pal.hexOf("dk1")))
    }

    sfn inkShadows:void (s:PptxShape ink:string) {
        if s.shadow.isSet {
            ; as dark as the style made it (simple3 lighter than simple5)
            s.shadow.color = (PptxColor.srgbOf(ink))
        }
        def i:int 0
        while (i < (array_length s.children)) {
            SaRender.inkShadows((itemAt s.children i) ink)
            i = (i + 1)
        }
    }

    ; Does the shape's outline hold (px, py)? Its box turned by its rotation
    ; and mirrored by its flips, then its preset's filled paths (even-odd);
    ; a preset the catalogue does not have is its box.
    sfn covers:boolean (b:PptxShape px:double py:double geo:OfficePresetShapes) {
        if ((b.width <= 0.0) || (b.height <= 0.0)) {
            return false
        }
        def cx:double (b.x + (b.width * 0.5))
        def cy:double (b.y + (b.height * 0.5))
        def qx:double px
        def qy:double py
        if (b.rotation != 0.0) {
            def a:double ((0.0 - b.rotation) * (3.141592653589793 / 180.0))
            def dx:double (px - cx)
            def dy:double (py - cy)
            qx = (cx + ((dx * (cos a)) - (dy * (sin a))))
            qy = (cy + ((dx * (sin a)) + (dy * (cos a))))
        }
        def u:double ((qx - b.x) / b.width)
        def v:double ((qy - b.y) / b.height)
        if ((((u < 0.0) || (v < 0.0)) || (u > 1.0)) || (v > 1.0)) {
            return false
        }
        if b.flipH {
            u = (1.0 - u)
        }
        if b.flipV {
            v = (1.0 - v)
        }
        if (((strlen b.preset) == 0) || ((geo.has(b.preset)) == false)) {
            return true
        }
        def paths:[GeomPath] (geo.pathsFor(b.preset b.width b.height b.adjNames b.adjValues))
        if ((array_length paths) == 0) {
            return true
        }
        def i:int 0
        while (i < (array_length paths)) {
            def gp:GeomPath (itemAt paths i)
            if (gp.fill != "none") {
                def inside:boolean false
                def r:int 0
                while (r < (array_length gp.rings)) {
                    def ring:PathRing (itemAt gp.rings r)
                    if (SaRender.inRing(ring.pts u v)) {
                        inside = (inside == false)
                    }
                    r = (r + 1)
                }
                if inside {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; even-odd: does a ray from (x, y) cross the ring an odd number of times
    sfn inRing:boolean (pts:[double] x:double y:double) {
        def n:int (to_int ((to_double (array_length pts)) / 2.0))
        if (n < 3) {
            return false
        }
        def inside:boolean false
        def j:int (n - 1)
        def i:int 0
        while (i < n) {
            def xi:double (itemAt pts (i * 2))
            def yi:double (itemAt pts ((i * 2) + 1))
            def xj:double (itemAt pts (j * 2))
            def yj:double (itemAt pts ((j * 2) + 1))
            if ((yi > y) != (yj > y)) {
                def xc:double (xi + (((y - yi) / (yj - yi)) * (xj - xi)))
                if (x < xc) {
                    inside = (inside == false)
                }
            }
            j = i
            i = (i + 1)
        }
        return inside
    }

    sfn filled:boolean (s:PptxShape) {
        return ((s.noFill == false) && (s.fill.isSet && ((strlen s.fill.srgb) >= 6)))
    }

    ; The painter a diagram is drawn with: one unit is one point, and the
    ; preset geometries the layouts use are loaded from SaPresets, never from
    ; a file (a browser and the Go server have none to read).
    sfn painter:PptxToEvg () {
        return (SaRender.painterWith((new SaMeasure())))
    }

    ; …measuring text as `m` does
    sfn painterWith:PptxToEvg (m:SaMeasure) {
        def conv (new PptxToEvg())
        if m.hasHost {
            def pm (new SaPaintMeasure())
            pm.sa = m
            pm.family = m.family
            conv.measure = pm
        }
        ; ptToPx is pt × 96/72 × scale: 0.75 makes it the identity
        conv.setScale(0.75)
        conv.loadPresets((SaPresets.text()))
        return conv
    }

    ; the group drawn with its top left at x, y (host units = points), its
    ; colours resolved first
    sfn paint:void (out:EVGDisplayList g:PptxShape pal:SaPalette x:double y:double) {
        SaRender.resolveAll(g pal)
        SaRender.draw(out g x y)
    }

    ; the group drawn as it is: its colours already resolved
    sfn draw:void (out:EVGDisplayList g:PptxShape x:double y:double) {
        SaRender.drawWith(out g x y (new SaMeasure()))
    }

    ; …its lines broken with `m`, the measure the engine fitted it with
    ; (SaResult.measure)
    sfn drawWith:void (out:EVGDisplayList g:PptxShape x:double y:double m:SaMeasure) {
        def conv:PptxToEvg (SaRender.painterWith(m))
        g.x = x
        g.y = y
        conv.emitShape(out g 0.0 0.0)
    }
}
