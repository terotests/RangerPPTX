; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaRender — a laid-out diagram, in a host's colours, into a display list
; ==============================================================================
;
; The engine's shapes name THEME colours (accent1, lt1, tx1, with a tint),
; because that is what a SmartArt in a deck means. A host that is not a
; PowerPoint deck — Sliqtly's slides — has its own palette, so it says what
; each name is (`SaPalette`), the colours are resolved with DrawingML's own
; tint and shade arithmetic (PptxResolver.applyMods), and the group is drawn
; by the same painter the deck editor uses (PptxToEvg), in the host's units:
; one unit is one point, which is what the engine laid it out in.
;
;   def pal (new SaPalette())
;   pal.set("accent1" "#1F6FEB")  ...
;   SaRender.paint(out res.shape pal x y)
;
; A host that measured with its fonts (SaMeasure.over) draws with
; `drawWith(out res.shape x y res.measure)`, so the lines break where the
; engine measured them.
; ==============================================================================

Import "SaEngine.rgr"
Import "SaPresets.rgr"
Import "../src/PptxResolver.rgr"
Import "../src/PptxToEvg.rgr"
Import "pkg:evg/EVGDisplayList.rgr"

class SaPalette {
    def names:[string]
    def hexes:[string]

    Constructor () {
    }

    ; `hex` with or without the #, six digits
    fn set:void (name:string hex:string) {
        def h:string (to_uppercase hex)
        if ((indexOf h "#") == 0) {
            h = (substring h 1 (strlen h))
        }
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                set hexes i h
                return
            }
            i = (i + 1)
        }
        push names name
        push hexes h
    }

    ; the hex for a scheme name; tx1/bg1/tx2/bg2 are dk1/lt1/dk2/lt2
    fn hexOf:string (name:string) {
        def n:string name
        if (n == "tx1") { n = "dk1" }
        if (n == "bg1") { n = "lt1" }
        if (n == "tx2") { n = "dk2" }
        if (n == "bg2") { n = "lt2" }
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == n) {
                return (itemAt hexes i)
            }
            i = (i + 1)
        }
        ; what a theme with nothing said has
        if ((n == "lt1") || (n == "lt2")) {
            return "FFFFFF"
        }
        if ((n == "dk1") || (n == "dk2")) {
            return "000000"
        }
        return "4472C4"
    }
}

; The painter's text measurer, answering with the engine's SaMeasure: the
; painter breaks a shape's lines with the widths the engine fitted its size
; with, and names the family they were measured in. Without a host measurer
; it is the painter's own (the same 0.52 em guess).
class SaPaintMeasure extends OfficeTextMeasure {
    def sa:SaMeasure (new SaMeasure())

    Constructor () {
    }

    fn hasFamily@(override):boolean (fam:string) {
        return true
    }

    fn drawnFamily@(override):string (named:string bold:boolean italic:boolean) {
        if ((strlen named) > 0) {
            return named
        }
        if sa.hasHost {
            return sa.family
        }
        return family
    }

    fn widthOfIn@(override):double (text:string sizePx:double bold:boolean italic:boolean named:string) {
        return (sa.widthOf(text sizePx bold))
    }
}

class SaRender {

    sfn resolve:void (c:PptxColor pal:SaPalette) {
        if ((c.isSet == false) || (c.isScheme == false)) {
            return
        }
        c.srgb = (PptxResolver.applyMods((pal.hexOf(c.scheme)) c))
        c.isScheme = false
        c.tint = 0.0
        c.shade = 0.0
        c.lumMod = 1.0
        c.lumOff = 0.0
        c.satMod = 1.0
    }

    ; every colour in the group, resolved in place
    sfn resolveAll:void (s:PptxShape pal:SaPalette) {
        SaRender.resolve(s.fill pal)
        SaRender.resolve(s.line pal)
        def p:int 0
        while (p < (array_length s.text.paragraphs)) {
            def para:PptxParagraph (itemAt s.text.paragraphs p)
            def r:int 0
            while (r < (array_length para.runs)) {
                def run:PptxTextRun (itemAt para.runs r)
                SaRender.resolve(run.color pal)
                r = (r + 1)
            }
            p = (p + 1)
        }
        def i:int 0
        while (i < (array_length s.children)) {
            SaRender.resolveAll((itemAt s.children i) pal)
            i = (i + 1)
        }
    }

    ; The painter a diagram is drawn with: one unit is one point, and the
    ; preset geometries the layouts use are loaded from SaPresets, never from
    ; a file (a browser and the Go server have none to read).
    sfn painter:PptxToEvg () {
        return (SaRender.painterWith((new SaMeasure())))
    }

    ; …measuring text as `m` does
    sfn painterWith:PptxToEvg (m:SaMeasure) {
        def conv (new PptxToEvg())
        if m.hasHost {
            def pm (new SaPaintMeasure())
            pm.sa = m
            pm.family = m.family
            conv.measure = pm
        }
        ; ptToPx is pt × 96/72 × scale: 0.75 makes it the identity
        conv.setScale(0.75)
        conv.loadPresets((SaPresets.text()))
        return conv
    }

    ; the group drawn with its top left at x, y (host units = points), its
    ; colours resolved first
    sfn paint:void (out:EVGDisplayList g:PptxShape pal:SaPalette x:double y:double) {
        SaRender.resolveAll(g pal)
        SaRender.draw(out g x y)
    }

    ; the group drawn as it is: its colours already resolved
    sfn draw:void (out:EVGDisplayList g:PptxShape x:double y:double) {
        SaRender.drawWith(out g x y (new SaMeasure()))
    }

    ; …its lines broken with `m`, the measure the engine fitted it with
    ; (SaResult.measure)
    sfn drawWith:void (out:EVGDisplayList g:PptxShape x:double y:double m:SaMeasure) {
        def conv:PptxToEvg (SaRender.painterWith(m))
        g.x = x
        g.y = y
        conv.emitShape(out g 0.0 0.0)
    }
}
