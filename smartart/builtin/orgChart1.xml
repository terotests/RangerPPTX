<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- orgChart1, "Organization Chart": as hierarchy1, square boxes, and an
     assistant (a point of type asst) beside the line down from the box it
     assists, above the row of the others. Written for this engine; see
     default.xml. -->
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram" uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/orgChart1">
  <dgm:title val="Organization Chart"/>
  <dgm:layoutNode name="hierChild1">
    <dgm:varLst><dgm:orgChart val="1"/><dgm:chPref val="1"/><dgm:dir/><dgm:animOne val="branch"/><dgm:animLvl val="lvl"/><dgm:resizeHandles/></dgm:varLst>
    <dgm:alg type="hierChild"/>
    <dgm:shape/>
    <dgm:constrLst>
      <dgm:constr type="w" for="des" forName="node" refType="w" fact="0.18"/>
      <dgm:constr type="h" for="des" forName="node" refType="w" refFor="des" refForName="node" fact="0.5"/>
      <dgm:constr type="w" for="des" forName="asstNode" refType="w" refFor="des" refForName="node"/>
      <dgm:constr type="h" for="des" forName="asstNode" refType="h" refFor="des" refForName="node"/>
      <dgm:constr type="sibSp" refType="w" refFor="des" refForName="node" fact="0.12"/>
      <dgm:constr type="sibSp" for="des" forName="hierChild2" refType="w" refFor="des" refForName="node" fact="0.12"/>
      <dgm:constr type="sibSp" for="des" forName="hierChild3" refType="w" refFor="des" refForName="node" fact="0.12"/>
      <dgm:constr type="sp" for="des" forName="hierRoot1" refType="h" refFor="des" refForName="node" fact="0.6"/>
      <dgm:constr type="sp" for="des" forName="hierRoot2" refType="h" refFor="des" refForName="node" fact="0.6"/>
      <dgm:constr type="primFontSz" for="des" forName="node" op="equ" val="65"/>
      <dgm:constr type="primFontSz" for="des" forName="asstNode" op="equ" val="65"/>
    </dgm:constrLst>
    <dgm:forEach name="branches" axis="ch" ptType="norm">
      <dgm:forEach name="toBranch" axis="precedSib" ptType="parTrans" cnt="1">
        <dgm:layoutNode name="line" styleLbl="parChTrans1D2">
          <dgm:alg type="conn"><dgm:param type="dim" val="1D"/><dgm:param type="endSty" val="noArr"/><dgm:param type="connRout" val="bend"/></dgm:alg>
          <dgm:shape type="conn"/>
        </dgm:layoutNode>
      </dgm:forEach>
      <dgm:layoutNode name="hierRoot1">
        <dgm:alg type="hierRoot"/>
        <dgm:shape/>
        <dgm:layoutNode name="node" styleLbl="node1">
          <dgm:alg type="tx"/>
          <dgm:shape type="rect"/>
          <dgm:presOf axis="self"/>
          <dgm:constrLst><dgm:constr type="tMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="bMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="lMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="rMarg" refType="primFontSz" fact="0.3"/></dgm:constrLst>
          <dgm:ruleLst><dgm:rule type="primFontSz" val="5" fact="NaN" max="NaN"/></dgm:ruleLst>
        </dgm:layoutNode>
        <dgm:layoutNode name="hierChild3">
          <dgm:alg type="hierChild"/>
          <dgm:shape/>
          <dgm:forEach name="assistants" axis="ch" ptType="asst">
            <dgm:forEach name="toAssistant" axis="precedSib" ptType="parTrans" cnt="1">
              <dgm:layoutNode name="asstLine" styleLbl="parChTrans1D2">
                <dgm:alg type="conn"><dgm:param type="dim" val="1D"/><dgm:param type="endSty" val="noArr"/><dgm:param type="connRout" val="bend"/></dgm:alg>
                <dgm:shape type="conn"/>
              </dgm:layoutNode>
            </dgm:forEach>
            <dgm:layoutNode name="hierRoot2">
              <dgm:alg type="hierRoot"/>
              <dgm:shape/>
              <dgm:layoutNode name="asstNode" styleLbl="node1">
                <dgm:alg type="tx"/>
                <dgm:shape type="rect"/>
                <dgm:presOf axis="self"/>
                <dgm:constrLst><dgm:constr type="tMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="bMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="lMarg" refType="primFontSz" fact="0.3"/><dgm:constr type="rMarg" refType="primFontSz" fact="0.3"/></dgm:constrLst>
                <dgm:ruleLst><dgm:rule type="primFontSz" val="5" fact="NaN" max="NaN"/></dgm:ruleLst>
              </dgm:layoutNode>
              <dgm:layoutNode name="hierChild2">
                <dgm:alg type="hierChild"/>
                <dgm:shape/>
                <dgm:forEach name="underAssistant" ref="branches"/>
              </dgm:layoutNode>
            </dgm:layoutNode>
          </dgm:forEach>
        </dgm:layoutNode>
        <dgm:layoutNode name="hierChild2">
          <dgm:alg type="hierChild"/>
          <dgm:shape/>
          <dgm:forEach name="under" ref="branches"/>
        </dgm:layoutNode>
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
