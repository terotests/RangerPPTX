; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaStyle — the colours and line a shape is drawn with
; ==============================================================================
;
; A layout node names a style label (`styleLbl="node1"`). The diagram's
; colour set (SaColors) says that label's fill, line and text colours, as
; theme colours, and how the shapes carrying it take them from its lists;
; the quick style (SaQuickStyle) says whether the line and fill are drawn,
; how wide the line is, and whether there is a shadow. The theme says what
; the colours are, so a diagram is in the deck's colours without any colour
; in the file, and changes with the theme.
;
; A colour set or quick style this engine does not have is drawn as
; accent1_2 / simple1, and the engine says so (SaEngine).
; ==============================================================================

Import "SaColors.rgr"
Import "SaQuickStyle.rgr"
Import "../src/PptxModel.rgr"

class SaPaint {
    def fill:PptxColor (new PptxColor())
    def noFill:boolean false
    def line:PptxColor (new PptxColor())
    def noLine:boolean false
    def lineWidthPt:double 1.0
    def text:PptxColor (new PptxColor())
    ; an outer shadow, from the quick style's effect: how far it falls and
    ; how soft it is, in points
    def shadow:boolean false
    def shadowDistPt:double 0.0
    def shadowBlurPt:double 0.0

    Constructor () {
    }
}

class SaStyle {

    sfn knownColors:boolean (id:string) {
        return (SaColors.known(id))
    }

    sfn knownStyle:boolean (id:string) {
        return (SaQuickStyle.known(id))
    }

    sfn short:string (id:string) {
        return (SaColors.short(id))
    }

    sfn family:string (lbl:string) {
        return (SaColors.family(lbl))
    }

    sfn scheme:PptxColor (name:string tint:double) {
        def c:PptxColor (PptxColor.schemeOf(name))
        c.tint = tint
        return c
    }

    ; the colour set with this id, accent1_2 when it is none this engine has
    sfn colorsDef:SaColorsDef (id:string) {
        def d:SaColorsDef (SaColors.builtin((SaColors.short(id))))
        if ((array_length d.labels) == 0) {
            return (SaColors.builtin("accent1_2"))
        }
        return d
    }

    ; the quick style with this id, simple1 when it is none this engine has
    sfn styleDef:SaQuickStyleDef (id:string) {
        def d:SaQuickStyleDef (SaQuickStyle.builtin((SaColors.short(id))))
        if ((array_length d.labels) == 0) {
            return (SaQuickStyle.builtin("simple1"))
        }
        return d
    }

    ; The label's colours in a set: its own entry, else one of its family's,
    ; else accent1_2's for it.
    sfn colorsLbl:SaColorsLbl (cd:SaColorsDef lbl:string) {
        def own@(optional):SaColorsLbl (cd.label(lbl))
        if (!null? own) {
            return (unwrap own)
        }
        def fam:string (SaColors.family(lbl))
        def i:int 0
        while (i < (array_length cd.labels)) {
            def l:SaColorsLbl (itemAt cd.labels i)
            if ((SaColors.family(l.name)) == fam) {
                return l
            }
            i = (i + 1)
        }
        return (SaColors.lblFor(lbl "accent_2" "accent1"))
    }

    ; How the idx-th of cnt shapes carrying `lbl` is drawn.
    sfn paint:SaPaint (lbl:string cd:SaColorsDef qs:SaQuickStyleDef idx:int cnt:int) {
        def p (new SaPaint())
        def cl:SaColorsLbl (SaStyle.colorsLbl(cd lbl))
        def ql:SaQsLbl (qs.label(lbl))
        if ((ql.fill > 0) && ((cl.fill.isEmpty()) == false)) {
            p.fill = (cl.fill.pick(idx cnt))
        } {
            p.noFill = true
        }
        if ((ql.ln > 0) && ((cl.line.isEmpty()) == false)) {
            p.line = (cl.line.pick(idx cnt))
            p.lineWidthPt = (SaQuickStyle.lineWidth(ql.ln))
        } {
            p.noLine = true
        }
        if (cl.text.isEmpty()) {
            p.text = (PptxColor.schemeOf("tx1"))
        } {
            p.text = (cl.text.pick(idx cnt))
        }
        if ((ql.effect > 0) && (p.noFill == false)) {
            p.shadow = true
            p.shadowDistPt = ((to_double ql.effect) * 1.5)
            p.shadowBlurPt = ((to_double ql.effect) * 3.0)
        }
        return p
    }

    ; the idx-th shape of a label, in a set named by id, simple1 (one of
    ; several, the count unknown: what a span needs is guessed)
    sfn paintFor:SaPaint (lbl:string colorsId:string idx:int) {
        return (SaStyle.paint(lbl (SaStyle.colorsDef(colorsId)) (SaStyle.styleDef("")) idx (idx + 1)))
    }
}
