; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaEngine — a SmartArt data model in, a drawn diagram out
; ==============================================================================
;
;   def r:SaResult (SaEngine.layout(xml (new SaOptions()) 480.0 270.0))
;   r.ok        the file was a diagram
;   r.error     why not, when it was not
;   r.shape     a PptxShape group (isDiagram), its children in the box's own
;               space: the same thing PptxParser makes from the drawing part
;               PowerPoint saves, so one representation is drawn, edited and
;               exported whoever laid the diagram out
;   r.warnings  what was drawn other than asked: an unknown layout or colour
;               set, text that did not fit
;
; The layout is the one the data's document point names (`loTypeId`), or
; `SaOptions.layout` when the host's Markdown overrides it, read from the
; built-in definitions (`builtin/`, embedded in SaBuiltins) — or one passed in
; whole (`layoutXml`), which is how a layout PowerPoint saved in a file is
; used. An id with no definition is drawn as `default` (Basic Block List,
; PowerPoint's own fallback) and said so.
; ==============================================================================

Import "SaModel.rgr"
Import "SaDataReader.rgr"
Import "SaDataWriter.rgr"
Import "SaLayoutReader.rgr"
Import "SaText.rgr"
Import "SaStyle.rgr"
Import "SaBuiltins.rgr"
Import "../src/PptxModel.rgr"

class SaOptions {
    ; overrides of what the data's document point names; a short name
    ; (`process1`) or a full id
    def layout:string ""
    def colors:string ""
    def style:string ""
    ; a whole layout definition, used instead of any id
    def layoutXml:string ""
    ; a whole colour set or quick style (a diagram's own, from its file),
    ; used instead of the id's built-in one
    def colorsXml:string ""
    def styleXml:string ""
    def measure:SaMeasure (new SaMeasure())
    ; a row of steps may wrap into rows when the box is tall (a slide host);
    ; PowerPoint never wraps them, so a deck editor leaves this off
    def wrap:boolean false

    Constructor () {
    }
}

class SaResult {
    def ok:boolean false
    def error:string ""
    def warnings:[string]
    def shape:PptxShape (new PptxShape())
    ; the layout that was used, by its short name
    def layoutUsed:string ""
    def ptree:SaPresTree (new SaPresTree())
    ; what the text was measured with, which the painter must break its lines
    ; with too (SaRender.drawWith)
    def measure:SaMeasure (new SaMeasure())

    Constructor () {
    }
}

; How a diagram's shapes are coloured: its colour set and quick style, and
; how many shapes carry each style label (what a colour span runs over).
class SaLook {
    def cd:SaColorsDef (new SaColorsDef())
    def qs:SaQuickStyleDef (new SaQuickStyleDef())
    def names:[string]
    def counts:[int]

    Constructor () {
    }

    fn count:void (name:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                set counts i ((itemAt counts i) + 1)
                return
            }
            i = (i + 1)
        }
        push names name
        push counts 1
    }

    fn countOf:int (name:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return (itemAt counts i)
            }
            i = (i + 1)
        }
        return 1
    }

    fn paint:SaPaint (s:SaInst) {
        return (SaStyle.paint(s.styleLbl cd qs s.nameIdx (this.countOf(s.name))))
    }
}

class SaEngine {

    sfn layout:SaResult (dataXml:string opts:SaOptions w:double h:double) {
        def read:SaReadResult (SaDataReader.read(dataXml))
        if (read.ok == false) {
            def bad (new SaResult())
            bad.error = read.error
            return bad
        }
        return (SaEngine.layoutModel(read.model opts w h))
    }

    sfn noItems:string () {
        return "the diagram has no items: no point is connected under the document point"
    }

    sfn fullId:string (s:string kind:string) {
        if ((indexOf s ":") >= 0) {
            return s
        }
        return ("urn:microsoft.com/office/officeart/2005/8/" + kind + "/" + s)
    }

    sfn layoutModel:SaResult (model:SaModel opts:SaOptions w:double h:double) {
        def res (new SaResult())
        model.complete()
        ; A diagram with no items is laid out as nothing (an editor can empty
        ; one and fill it again), and says so: a host that draws nothing
        ; shows this reason in its place.
        def docPt:SaPoint (model.doc())
        def items:[SaPoint] (model.children(docPt.id))
        if ((array_length items) == 0) {
            push res.warnings (SaEngine.noItems())
        }
        ; which layout
        def lo (new SaLayoutDef())
        def loXml:string opts.layoutXml
        if ((strlen opts.layoutXml) > 0) {
            def lr:SaLayoutReadResult (SaLayoutReader.read(opts.layoutXml))
            if (lr.ok == false) {
                res.error = ("the layout definition: " + lr.error)
                return res
            }
            lo = lr.layout
        } {
            def want:string (model.layoutId())
            if ((strlen opts.layout) > 0) {
                want = opts.layout
            }
            def shortWant:string (SaLayoutDef.shortOf(want))
            def xml:string (SaBuiltins.layoutXml(shortWant))
            if ((strlen xml) == 0) {
                if ((strlen shortWant) > 0) {
                    push res.warnings ("the layout \"" + shortWant + "\" is not one this engine has; drawn as default (it has: " + (SaBuiltins.names()) + ")")
                }
                xml = (SaBuiltins.layoutXml("default"))
            }
            def lr2:SaLayoutReadResult (SaLayoutReader.read(xml))
            if (lr2.ok == false) {
                res.error = ("the built-in layout " + shortWant + ": " + lr2.error)
                return res
            }
            lo = lr2.layout
            loXml = xml
        }
        res.layoutUsed = (lo.shortId())
        def colors:string ((model.doc()).colorsId)
        if ((strlen opts.colors) > 0) {
            colors = (SaEngine.fullId(opts.colors "colors"))
        }
        if (((strlen opts.colorsXml) == 0) && ((SaStyle.knownColors(colors)) == false)) {
            push res.warnings ("the colour set \"" + (SaStyle.short(colors)) + "\" is not one this engine has; drawn as accent1_2 (it has: " + (SaColors.names()) + ")")
            colors = ""
        }
        ; run it
        def ptree:SaPresTree (SaPresTree.build(model lo))
        if ((strlen ptree.error) > 0) {
            res.error = ptree.error
            return res
        }
        ptree.numberByName()
        res.ptree = ptree
        res.measure = opts.measure
        def cons:SaConstraints (SaConstraints.resolve(ptree w h))
        def algs:SaAlgorithms (SaAlgorithms.runWith(cons opts.wrap))
        def text:SaText (SaText.fit(cons opts.measure))
        ; A slide host (wrap): a row of shapes that keep their proportions
        ; and fill less than half the box's height, their text broken onto
        ; several lines — three long-texted chevrons across a slide — is made
        ; taller, when that sets the text clearly larger. PowerPoint keeps the proportions; a slide has the
        ; room.
        if ((opts.wrap && ((SaEngine.heightUsed(ptree)) < (h * 0.5))) && (text.breaks())) {
            def best:double (SaEngine.leastFont(ptree))
            def tries:[double] ([] _:double (1.4 1.8 2.4))
            def ti:int 0
            while (ti < (array_length tries)) {
                def pt2:SaPresTree (SaPresTree.build(model lo))
                pt2.numberByName()
                def c2:SaConstraints (SaConstraints.resolve(pt2 w h))
                def a2:SaAlgorithms (SaAlgorithms.runStretched(c2 true (itemAt tries ti)))
                if (a2.stretched == false) {
                    break
                }
                def t2:SaText (SaText.fit(c2 opts.measure))
                def least:double (SaEngine.leastFont(pt2))
                if ((least >= (best * 1.12)) && ((array_length t2.warnings) <= (array_length text.warnings))) {
                    ptree = pt2
                    cons = c2
                    algs = a2
                    text = t2
                    best = least
                }
                ti = (ti + 1)
            }
            res.ptree = ptree
        }
        def k:int 0
        while (k < (array_length algs.warnings)) {
            push res.warnings (itemAt algs.warnings k)
            k = (k + 1)
        }
        k = 0
        while (k < (array_length text.warnings)) {
            push res.warnings (itemAt text.warnings k)
            k = (k + 1)
        }
        ; draw it
        def g (new PptxShape())
        g.kind = (PptxShapeKind.group())
        g.isDiagram = true
        g.name = "Diagram"
        g.x = 0.0
        g.y = 0.0
        g.width = w
        g.height = h
        g.hasXfrm = true
        g.hasOff = true
        g.hasExt = true
        g.chX = 0.0
        g.chY = 0.0
        g.chW = w
        g.chH = h
        g.diagramText = (model.outline())
        ; what it was made from, with the ids it was drawn with, so the writer
        ; can save it as SmartArt and the editor can lay it out again
        def style:string ((model.doc()).styleId)
        if ((strlen opts.style) > 0) {
            style = (SaEngine.fullId(opts.style "quickstyle"))
        }
        def look (new SaLook())
        look.qs = (SaStyle.styleDef(style))
        if ((strlen opts.styleXml) > 0) {
            def sr:SaQuickStyleRead (SaQuickStyle.read(opts.styleXml))
            if sr.ok {
                look.qs = sr.def
                if ((strlen sr.def.uniqueId) > 0) {
                    style = sr.def.uniqueId
                }
            }
        } {
            if ((SaStyle.knownStyle(style)) == false) {
                push res.warnings ("the quick style \"" + (SaStyle.short(style)) + "\" is not one this engine has; drawn as simple1 (it has: " + (SaQuickStyle.names()) + ")")
                style = ""
            }
        }
        if ((strlen style) == 0) {
            style = (SaEngine.fullId("simple1" "quickstyle"))
        }
        def colorsUsed:string colors
        if ((strlen colorsUsed) == 0) {
            colorsUsed = (SaEngine.fullId("accent1_2" "colors"))
        }
        look.cd = (SaStyle.colorsDef(colorsUsed))
        if ((strlen opts.colorsXml) > 0) {
            def cr:SaColorsRead (SaColors.read(opts.colorsXml))
            if cr.ok {
                look.cd = cr.def
                if ((strlen cr.def.uniqueId) > 0) {
                    colorsUsed = cr.def.uniqueId
                }
            }
        }
        def d:SaPoint (model.doc())
        d.layoutId = lo.uniqueId
        d.styleId = style
        d.colorsId = colorsUsed
        g.diagramModelXml = (SaDataWriter.write(model))
        g.diagramLayoutXml = loXml
        g.diagramLayoutId = lo.uniqueId
        g.diagramStyleId = style
        g.diagramColorsId = colorsUsed
        def every:[SaInst] (ptree.all())
        def ci:int 0
        while (ci < (array_length every)) {
            def cs:SaInst (itemAt every ci)
            look.count(cs.name)
            ci = (ci + 1)
        }
        ; the points whose text some shape shows
        def shown:[string]
        def i:int 0
        while (i < (array_length every)) {
            def s:SaInst (itemAt every i)
            if ((array_length s.segs) >= 4) {
                SaEngine.linesOf(s look g.children)
            } {
                def made@(optional):PptxShape (SaEngine.shapeOf(s text look))
                if (!null? made) {
                    push g.children (unwrap made)
                    def lines:[SaLine] (text.linesOf(s))
                    def li:int 0
                    while (li < (array_length lines)) {
                        def ln:SaLine (itemAt lines li)
                        push shown ln.ptId
                        li = (li + 1)
                    }
                }
            }
            i = (i + 1)
        }
        def left:string (SaEngine.notShown(model shown res.layoutUsed))
        if ((strlen left) > 0) {
            push res.warnings left
        }
        ; what the shapes say now: a diagram whose shapes were changed by
        ; hand no longer matches it, and is saved as those shapes
        g.diagramSig = (g.diagramSignature())
        g.diagramStyleXml = opts.styleXml
        g.diagramColorsXml = opts.colorsXml
        res.shape = g
        res.ok = true
        return res
    }

    ; the smallest size any shape's text was set at; 0 when none has text
    sfn leastFont:double (ptree:SaPresTree) {
        def every:[SaInst] (ptree.all())
        def least:double 0.0
        def i:int 0
        while (i < (array_length every)) {
            def s:SaInst (itemAt every i)
            if ((s.fontPt > 0.0) && ((least == 0.0) || (s.fontPt < least))) {
                least = s.fontPt
            }
            i = (i + 1)
        }
        return least
    }

    ; how tall the drawn shapes are together, top of the highest to the
    ; bottom of the lowest
    sfn heightUsed:double (ptree:SaPresTree) {
        def every:[SaInst] (ptree.all())
        def top:double 0.0
        def bottom:double 0.0
        def any:boolean false
        def i:int 0
        while (i < (array_length every)) {
            def s:SaInst (itemAt every i)
            if (((s.hasShape && (s.shape.type != "none")) && (s.w > 0.0)) && (s.h > 0.0)) {
                if ((any == false) || (s.y < top)) {
                    top = s.y
                }
                if ((any == false) || ((s.y + s.h) > bottom)) {
                    bottom = (s.y + s.h)
                }
                any = true
            }
            i = (i + 1)
        }
        return (bottom - top)
    }

    ; What the layout left out: the items with text that no shape shows (a
    ; layout holds as many as it has places for — gear1 three, cycle4 four),
    ; named, so whoever wrote the file knows what the slide does not say.
    ; "" when every item is drawn.
    sfn notShown:string (model:SaModel shown:[string] layout:string) {
        def all:[SaPoint]
        SaEngine.contentUnder(model ((model.doc()).id) all)
        def missing:[string]
        def total:int 0
        def i:int 0
        while (i < (array_length all)) {
            def p:SaPoint (itemAt all i)
            def t:string (trim (p.plainText()))
            if ((strlen t) > 0) {
                total = (total + 1)
                if ((indexOf shown p.id) < 0) {
                    push missing ("\"" + t + "\"")
                }
            }
            i = (i + 1)
        }
        def n:int (array_length missing)
        if (n == 0) {
            return ""
        }
        return ("the layout " + layout + " has a place for " + (to_string (total - n)) + " of the " + (to_string total) + " items; not drawn: " + (join missing ", "))
    }

    sfn contentUnder:void (model:SaModel id:string out:[SaPoint]) {
        def kids:[SaPoint] (model.children(id))
        def i:int 0
        while (i < (array_length kids)) {
            def k:SaPoint (itemAt kids i)
            if (k.isContent()) {
                push out k
                SaEngine.contentUnder(model k.id out)
            }
            i = (i + 1)
        }
    }

    ; A connector line: one `line` shape per segment, its box the segment's
    ; bounds, flipped when the segment runs up or left; an arrowhead at the
    ; end of the last when the connector has one.
    sfn linesOf:void (s:SaInst look:SaLook out:[PptxShape]) {
        def paint:SaPaint (look.paint(s))
        def col:PptxColor paint.line
        if paint.noLine {
            col = paint.fill
        }
        def n:int (array_length s.segs)
        def i:int 0
        while ((i + 3) < n) {
            def x1:double (itemAt s.segs i)
            def y1:double (itemAt s.segs (i + 1))
            def x2:double (itemAt s.segs (i + 2))
            def y2:double (itemAt s.segs (i + 3))
            def sh (new PptxShape())
            sh.kind = (PptxShapeKind.shape())
            sh.name = (s.name + " " + (to_string (s.nameIdx + 1)) + "." + (to_string ((to_int ((to_double i) / 4.0)) + 1)))
            sh.x = x1
            if (x2 < x1) {
                sh.x = x2
            }
            sh.y = y1
            if (y2 < y1) {
                sh.y = y2
            }
            sh.width = (fabs (x2 - x1))
            sh.height = (fabs (y2 - y1))
            sh.flipH = (x2 < x1)
            sh.flipV = (y2 < y1)
            sh.hasXfrm = true
            sh.hasOff = true
            sh.hasExt = true
            sh.preset = "line"
            sh.noFill = true
            sh.line = col
            sh.lineWidthPt = paint.lineWidthPt
            if (sh.lineWidthPt < 1.0) {
                sh.lineWidthPt = 1.0
            }
            if (s.arrowEnd && ((i + 4) >= n)) {
                sh.tailEnd = "triangle"
            }
            push out sh
            i = (i + 4)
        }
    }

    ; the preset a connector is drawn as, by the way its line goes
    sfn arrowFor:double (dir:double) {
        return dir
    }

    sfn connPreset:string (dir:double) {
        if (dir == 180.0) {
            return "leftArrow"
        }
        if (dir == 90.0) {
            return "downArrow"
        }
        if (dir == 270.0) {
            return "upArrow"
        }
        return "rightArrow"
    }

    ; what a preset calls its adjustments, in order
    sfn adjName:string (preset:string idx:int) {
        def two:string " rightArrow leftArrow upArrow downArrow leftRightArrow upDownArrow notchedRightArrow stripedRightArrow "
        if ((indexOf two (" " + preset + " ")) >= 0) {
            return ("adj" + (to_string idx))
        }
        if (idx == 1) {
            return "adj"
        }
        return ("adj" + (to_string idx))
    }

    sfn shapeOf@(optional):PptxShape (s:SaInst text:SaText look:SaLook) {
        def none@(optional):PptxShape
        def lines:[SaLine] (text.linesOf(s))
        def geometry:boolean ((s.hasShape && (s.shape.type != "none")) && (s.shape.hideGeom == false))
        if ((geometry == false) && ((array_length lines) == 0)) {
            return none
        }
        if ((s.w <= 0.0) || (s.h <= 0.0)) {
            return none
        }
        def sh (new PptxShape())
        sh.kind = (PptxShapeKind.shape())
        sh.name = (s.name + " " + (to_string (s.nameIdx + 1)))
        sh.x = s.x
        sh.y = s.y
        sh.width = s.w
        sh.height = s.h
        sh.hasXfrm = true
        sh.hasOff = true
        sh.hasExt = true
        sh.rotation = (s.shape.rot + s.rotDeg)
        def preset:string s.shape.type
        if ((preset == "conn") || (s.alg.type == "conn")) {
            preset = (SaEngine.connPreset((s.raw("connDir" 0.0))))
        }
        if ((preset == "none") || (preset == "")) {
            preset = "rect"
        }
        sh.preset = preset
        def a:int 0
        if ((array_length s.adjNames) > 0) {
            ; an algorithm's own, for this one shape
            while (a < (array_length s.adjNames)) {
                def an:string (itemAt s.adjNames a)
                def av:double (itemAt s.adjVals a)
                push sh.adjNames an
                push sh.adjValues av
                if (an == "adj") {
                    sh.adj = (av / 100000.0)
                }
                a = (a + 1)
            }
            a = (array_length s.shape.adj)
        }
        while (a < (array_length s.shape.adj)) {
            if (itemAt s.shape.adjSet a) {
                def v:double (itemAt s.shape.adj a)
                def nm:string (SaEngine.adjName(preset (a + 1)))
                push sh.adjNames nm
                push sh.adjValues (v * 100000.0)
                if (nm == "adj") {
                    sh.adj = v
                }
            }
            a = (a + 1)
        }
        ; a shape a host's row made taller keeps its point as deep as it was
        ; (the depth is a fraction of the shorter side, which grew)
        if ((s.stretchK > 1.0) && ((preset == "chevron") || (preset == "homePlate"))) {
            def side:double s.w
            if (s.h < side) {
                side = s.h
            }
            def f:double ((s.h / s.stretchK) / side)
            def found:boolean false
            def ai:int 0
            while (ai < (array_length sh.adjNames)) {
                if ((itemAt sh.adjNames ai) == "adj") {
                    set sh.adjValues ai ((itemAt sh.adjValues ai) * f)
                    sh.adj = (sh.adj * f)
                    found = true
                }
                ai = (ai + 1)
            }
            if (found == false) {
                push sh.adjNames "adj"
                push sh.adjValues (50000.0 * f)
                sh.adj = (0.5 * f)
            }
        }
        def paint:SaPaint (look.paint(s))
        if (geometry == false) {
            paint.noFill = true
            paint.noLine = true
        }
        if paint.noFill {
            sh.noFill = true
        } {
            sh.fill = paint.fill
        }
        if paint.noLine {
            sh.noLine = true
        } {
            sh.line = paint.line
            sh.lineWidthPt = paint.lineWidthPt
        }
        if paint.shadow {
            sh.shadow.isSet = true
            sh.shadow.offsetXPt = 0.0
            sh.shadow.offsetYPt = paint.shadowDistPt
            sh.shadow.blurPt = paint.shadowBlurPt
            sh.shadow.color = (PptxColor.srgbOf("000000"))
            sh.shadow.alpha = paint.shadowAlpha
        }
        if ((array_length lines) > 0) {
            sh.hasText = true
            def body:PptxTextBody sh.text
            def size:double s.fontPt
            body.insetL = (text.margin(s "lMarg" size))
            body.insetR = (text.margin(s "rMarg" size))
            body.insetT = (text.margin(s "tMarg" size))
            body.insetB = (text.margin(s "bMarg" size))
            body.insetsSet = true
            def anchor:string (s.alg.param("txAnchorVert" "mid"))
            body.anchor = "ctr"
            if (anchor == "t") {
                body.anchor = "t"
            }
            if (anchor == "b") {
                body.anchor = "b"
            }
            body.anchorSet = true
            body.wrap = true
            def align:string (s.alg.param("parTxLTRAlign" "ctr"))
            def k:int 0
            while (k < (array_length lines)) {
                def ln:SaLine (itemAt lines k)
                def para (new PptxParagraph())
                para.level = ln.level
                para.alignSet = true
                para.lineSpacingPct = 90.0
                if (ln.level > 0) {
                    para.align = "l"
                    para.hasBullet = true
                    para.bulletSet = true
                    para.bulletChar = "•"
                    para.marginLeftPt = ((to_double ln.level) * size * 0.6)
                    para.indentPt = (0.0 - (size * 0.6))
                    para.marginSet = true
                    para.indentSet = true
                } {
                    para.align = align
                }
                def run (new PptxTextRun())
                run.text = ln.text
                run.fontSizePt = size
                run.sizeSet = true
                run.bold = ln.bold
                run.boldSet = ln.bold
                run.color = paint.text
                run.colorStated = true
                if text.measure.hasHost {
                    run.fontFamily = text.measure.family
                }
                push para.runs run
                push body.paragraphs para
                push sh.diagramParaPts ln.ptId
                k = (k + 1)
            }
        }
        def hit@(optional):PptxShape sh
        return hit
    }
}
