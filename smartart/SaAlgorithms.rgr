; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SaAlgorithms — where each shape goes
; ==============================================================================
;
; Run top-down from the root, whose box is the frame. Each instance's
; algorithm places its children inside its own box; then each child's subtree
; is sized again (its constraints re-run with its new box) and placed in turn.
;
;   lin        children in a row or a column (`linDir` fromL fromR fromT fromB),
;              `sibSp` apart, centred along the line and aligned across it
;              (`nodeVertAlign` / `nodeHorzAlign`). A line longer than the box
;              is SHRUNK to fit: every length along it, and across it every
;              size that was derived from a length along it — a step whose
;              height is 0.6 of its width stays that shape; a column whose
;              height is its parent's keeps it. Then, if something is still
;              taller (wider) than the box, everything shrinks once more.
;   composite  children where their own l / t / r / b / ctrX / ctrY say,
;              relative to the box, at the w / h they were given
;   tx, sp, conn
;              nothing to place. tx is text in the node's own shape (SaText);
;              sp is room; a conn among a lin's children is placed by the lin
;              like any child, and drawn as an arrow pointing along it.
;              With `wrap` (SaOptions.wrap, a host that is not PowerPoint), a
;              row of shapes that keep their proportions is broken into rows
;              when that makes them clearly larger: eight steps in a tall box
;              are two rows of four, not one strip a tenth of its height.
;   snake      a grid that wraps (SaSnake)
;   cycle      a circle, or a radial with a shape in the middle (SaCycle)
;   hierRoot, hierChild
;              a tree, laid out at once from its outermost hierChild (SaHier)
;   pyra       a triangle cut into levels (SaPyra)
;
; A connector its parent's algorithm did not place goes between the shapes
; it names, or the ones before and after it (SaConn.connect).
; ==============================================================================

Import "SaConstraints.rgr"
Import "SaConn.rgr"
Import "SaSnake.rgr"
Import "SaCycle.rgr"
Import "SaHier.rgr"
Import "SaPyra.rgr"

class SaAlgorithms {
    def cons:SaConstraints (new SaConstraints())
    def warnings:[string]
    ; break a lin row into rows when the box is tall enough (linRows)
    def wrap:boolean false

    Constructor () {
    }

    sfn run:SaAlgorithms (c:SaConstraints) {
        return (SaAlgorithms.runWith(c false))
    }

    sfn runWith:SaAlgorithms (c:SaConstraints wrap:boolean) {
        def a (new SaAlgorithms())
        a.cons = c
        a.wrap = wrap
        def r:SaInst c.ptree.root
        r.x = 0.0
        r.y = 0.0
        r.w = c.frameW
        r.h = c.frameH
        a.place(r)
        return a
    }

    fn warnOnce:void (msg:string) {
        def i:int 0
        while (i < (array_length warnings)) {
            if ((itemAt warnings i) == msg) {
                return
            }
            i = (i + 1)
        }
        push warnings msg
    }

    fn place:void (p:SaInst) {
        def t:string p.alg.type
        if (((array_length p.children) > 0) && (p.placed == false)) {
            if ((t == "lin") || (t == "")) {
                this.lin(p)
            }
            if (((t == "composite") || (t == "tx")) || ((t == "sp") || (t == "conn"))) {
                this.composite(p)
                SaConn.connect(cons p)
            }
            if (t == "snake") {
                SaSnake.place(cons p)
            }
            if (t == "cycle") {
                SaCycle.place(cons p)
            }
            if ((t == "hierChild") || (t == "hierRoot")) {
                SaHier.place(cons p)
            }
            if (t == "pyra") {
                SaPyra.place(cons p)
            }
        }
        def i:int 0
        while (i < (array_length p.children)) {
            def c:SaInst (itemAt p.children i)
            this.resize(c)
            this.place(c)
            i = (i + 1)
        }
    }

    ; A child's subtree sized again for the box its parent gave it: its own
    ; constraints, and its descendants', re-run with its w and h fixed.
    fn resize:void (c:SaInst) {
        c.put("w" c.w (c.fromOf("w")))
        c.put("h" c.h (c.fromOf("h")))
        def subtree:[SaInst]
        push subtree c
        c.collect(subtree)
        def pass:int 0
        while (pass < 2) {
            def i:int 0
            while (i < (array_length subtree)) {
                def s:SaInst (itemAt subtree i)
                def k:int 0
                while (k < (array_length s.constrs)) {
                    def con:SaConstr (itemAt s.constrs k)
                    ; the box is the parent's to give: a node's own w and h
                    ; constraints do not undo it
                    def ownSize:boolean (((s == c) && (con.forRel == "self")) && ((con.type == "w") || (con.type == "h")))
                    if (ownSize == false) {
                        cons.apply(s con)
                    }
                    k = (k + 1)
                }
                i = (i + 1)
            }
            pass = (pass + 1)
        }
        c.put("w" c.w (c.fromOf("w")))
        c.put("h" c.h (c.fromOf("h")))
    }

    fn lin:void (p:SaInst) {
        def dir:string (p.alg.param("linDir" "fromL"))
        def vertical:boolean ((dir == "fromT") || (dir == "fromB"))
        def n:int (array_length p.children)
        def along:[double]
        def across:[double]
        def tied:[boolean]
        def i:int 0
        while (i < n) {
            def c:SaInst (itemAt p.children i)
            def cw:double (cons.get(c "w"))
            def chh:double (cons.get(c "h"))
            if vertical {
                push along chh
                push across cw
                push tied ((c.fromOf("w")) == "h")
            } {
                push along cw
                push across chh
                push tied ((c.fromOf("h")) == "w")
            }
            i = (i + 1)
        }
        def sp:double (cons.get(p "sibSp"))
        def room:double (? vertical p.h p.w)
        def roomAcross:double (? vertical p.w p.h)
        def total:double (SaAlgorithms.sum(along) + (sp * (to_double (n - 1))))
        if (wrap && (dir == "fromL")) {
            if (this.linRows(p along across tied sp)) {
                return
            }
        }
        ; too long: shrink along the line, and what is tied to it
        if ((total > room) && (total > 0.0)) {
            def s:double (room / total)
            i = 0
            while (i < n) {
                set along i ((itemAt along i) * s)
                if (itemAt tied i) {
                    set across i ((itemAt across i) * s)
                }
                i = (i + 1)
            }
            sp = (sp * s)
            total = room
        }
        ; still too big across: shrink everything
        def maxAcross:double (SaAlgorithms.max(across))
        if ((maxAcross > roomAcross) && (maxAcross > 0.0)) {
            def s2:double (roomAcross / maxAcross)
            i = 0
            while (i < n) {
                set along i ((itemAt along i) * s2)
                set across i ((itemAt across i) * s2)
                i = (i + 1)
            }
            sp = (sp * s2)
            total = (total * s2)
        }
        def alignV:string (p.alg.param("nodeVertAlign" "mid"))
        def alignH:string (p.alg.param("nodeHorzAlign" "ctr"))
        def at:double ((room - total) / 2.0)
        i = 0
        while (i < n) {
            def idx:int i
            if ((dir == "fromR") || (dir == "fromB")) {
                idx = ((n - 1) - i)
            }
            def c2:SaInst (itemAt p.children idx)
            def a:double (itemAt along idx)
            def b:double (itemAt across idx)
            def off:double ((roomAcross - b) / 2.0)
            if vertical {
                if (alignH == "l") {
                    off = 0.0
                }
                if (alignH == "r") {
                    off = (roomAcross - b)
                }
                c2.x = (p.x + off)
                c2.y = (p.y + at)
                c2.w = b
                c2.h = a
            } {
                if (alignV == "t") {
                    off = 0.0
                }
                if (alignV == "b") {
                    off = (roomAcross - b)
                }
                c2.x = (p.x + at)
                c2.y = (p.y + off)
                c2.w = a
                c2.h = b
            }
            ; a connector points the way the line goes
            if (c2.alg.type == "conn") {
                c2.put("connDir" (SaAlgorithms.dirCode(dir)) "")
            }
            at = ((at + a) + sp)
            i = (i + 1)
        }
    }

    ; The scale a lin row's shapes get in a box of room × roomAcross: as
    ; large as fits along and across, never larger than they are.
    sfn rowScale:double (len:double high:double room:double roomAcross:double) {
        if ((len <= 0.0) || (high <= 0.0)) {
            return 0.0
        }
        def s:double (room / len)
        if ((roomAcross / high) < s) {
            s = (roomAcross / high)
        }
        if (s > 1.0) {
            s = 1.0
        }
        return s
    }

    ; Where row `r` of `rows` ends: the index after the last child it holds.
    ; Each row takes `per` shapes and the connectors that follow them, so an
    ; arrow at a row's end says the steps go on in the next.
    sfn rowEnds:[int] (p:SaInst per:int) {
        def ends:[int]
        def n:int (array_length p.children)
        def cells:int 0
        def i:int 0
        while (i < n) {
            def c:SaInst (itemAt p.children i)
            if (SaConn.isCell(c)) {
                if (cells == per) {
                    push ends i
                    cells = 0
                }
                cells = (cells + 1)
            }
            i = (i + 1)
        }
        push ends n
        return ends
    }

    ; A horizontal lin's children in rows of three or more, when rows make
    ; its shapes at least a fifth larger than one row does; false leaves it
    ; to the one row.
    ; Only shapes whose height follows their width wrap: one as tall as the
    ; box (a list's column) has no row to share.
    fn linRows:boolean (p:SaInst along:[double] across:[double] tied:[boolean] sp:double) {
        def n:int (array_length p.children)
        def cellCount:int 0
        def i:int 0
        while (i < n) {
            def c:SaInst (itemAt p.children i)
            if (SaConn.isCell(c)) {
                cellCount = (cellCount + 1)
                if ((itemAt tied i) == false) {
                    return false
                }
            }
            i = (i + 1)
        }
        if (cellCount < 2) {
            return false
        }
        def room:double p.w
        def roomAcross:double p.h
        def high:double (SaAlgorithms.max(across))
        ; rows a quarter of a shape apart
        def gap:double (high * 0.25)
        def single:double (SaAlgorithms.rowScale((SaAlgorithms.sum(along) + (sp * (to_double (n - 1)))) high room roomAcross))
        def best:double (single * 1.2)
        def bestPer:int 0
        def rows:int 2
        while (rows <= cellCount) {
            def per:int (to_int ((to_double (cellCount + rows - 1)) / (to_double rows)))
            ; the same rows as one row fewer would give; and a row of fewer
            ; than three steps no longer reads as a process
            if (((per * (rows - 1)) < cellCount) && (per >= 3)) {
                def ends:[int] (SaAlgorithms.rowEnds(p per))
                def longest:double 0.0
                def from:int 0
                def r:int 0
                while (r < (array_length ends)) {
                    def to:int (itemAt ends r)
                    def len:double 0.0
                    def k:int from
                    while (k < to) {
                        len = (len + (itemAt along k))
                        k = (k + 1)
                    }
                    len = (len + (sp * (to_double ((to - from) - 1))))
                    if (len > longest) {
                        longest = len
                    }
                    from = to
                    r = (r + 1)
                }
                def tall:double (((to_double (array_length ends)) * high) + (gap * (to_double ((array_length ends) - 1))))
                def s:double (SaAlgorithms.rowScale(longest tall room roomAcross))
                if (s > best) {
                    best = s
                    bestPer = per
                }
            }
            rows = (rows + 1)
        }
        if (bestPer == 0) {
            return false
        }
        ; placed: every row starts where the longest does, the rows centred
        ; in the box together
        def ends2:[int] (SaAlgorithms.rowEnds(p bestPer))
        def longest2:double 0.0
        def from2:int 0
        def r2:int 0
        while (r2 < (array_length ends2)) {
            def to2:int (itemAt ends2 r2)
            def len2:double 0.0
            def k2:int from2
            while (k2 < to2) {
                len2 = (len2 + ((itemAt along k2) * best))
                k2 = (k2 + 1)
            }
            len2 = (len2 + ((sp * best) * (to_double ((to2 - from2) - 1))))
            if (len2 > longest2) {
                longest2 = len2
            }
            from2 = to2
            r2 = (r2 + 1)
        }
        def rowH:double (high * best)
        def rowGap:double (gap * best)
        def count:int (array_length ends2)
        def y:double (p.y + ((roomAcross - (((to_double count) * rowH) + (rowGap * (to_double (count - 1))))) / 2.0))
        def x0:double (p.x + ((room - longest2) / 2.0))
        def start:int 0
        def row:int 0
        while (row < count) {
            def stop:int (itemAt ends2 row)
            def at:double x0
            def j:int start
            while (j < stop) {
                def c2:SaInst (itemAt p.children j)
                def a:double ((itemAt along j) * best)
                def b:double ((itemAt across j) * best)
                c2.x = at
                c2.y = (y + ((rowH - b) / 2.0))
                c2.w = a
                c2.h = b
                if (c2.alg.type == "conn") {
                    c2.put("connDir" 0.0 "")
                }
                at = ((at + a) + (sp * best))
                j = (j + 1)
            }
            y = ((y + rowH) + rowGap)
            start = stop
            row = (row + 1)
        }
        return true
    }

    sfn dirCode:double (dir:string) {
        if (dir == "fromR") { return 180.0 }
        if (dir == "fromT") { return 90.0 }
        if (dir == "fromB") { return 270.0 }
        return 0.0
    }

    fn composite:void (p:SaInst) {
        def i:int 0
        while (i < (array_length p.children)) {
            def c:SaInst (itemAt p.children i)
            def w:double (cons.get(c "w"))
            def h:double (cons.get(c "h"))
            def x:double 0.0
            def y:double 0.0
            if (c.has("l")) {
                x = (c.raw("l" 0.0))
            } {
                if (c.has("ctrX")) {
                    x = ((c.raw("ctrX" 0.0)) - (w / 2.0))
                } {
                    if (c.has("r")) {
                        x = ((c.raw("r" 0.0)) - w)
                    }
                }
            }
            if (c.has("t")) {
                y = (c.raw("t" 0.0))
            } {
                if (c.has("ctrY")) {
                    y = ((c.raw("ctrY" 0.0)) - (h / 2.0))
                } {
                    if (c.has("b")) {
                        y = ((c.raw("b" 0.0)) - h)
                    }
                }
            }
            ; both edges given: the width is what lies between them
            if ((c.has("l")) && (c.has("r"))) {
                w = ((c.raw("r" 0.0)) - x)
            }
            if ((c.has("t")) && (c.has("b"))) {
                h = ((c.raw("b" 0.0)) - y)
            }
            c.x = (p.x + x)
            c.y = (p.y + y)
            c.w = w
            c.h = h
            i = (i + 1)
        }
    }

    sfn sum:double (xs:[double]) {
        def s:double 0.0
        def i:int 0
        while (i < (array_length xs)) {
            s = (s + (itemAt xs i))
            i = (i + 1)
        }
        return s
    }

    sfn max:double (xs:[double]) {
        def m:double 0.0
        def i:int 0
        while (i < (array_length xs)) {
            if ((itemAt xs i) > m) {
                m = (itemAt xs i)
            }
            i = (i + 1)
        }
        return m
    }
}
